<view class="page-container">
  <view class="hero-card">
    <view class="hero-title">QuantLabAI 量化回测分析</view>
    <view class="hero-desc">面向金融专业学生和量化初学者的历史回测、风险分析与策略学习工具。</view>
  </view>

  <view class="card">
    <view class="section-title">回测参数</view>

    <view class="form-item">
      <view class="form-label">股票代码</view>
      <input class="form-input" type="text" value="{{symbol}}" placeholder="请输入股票代码" bindinput="onInputSymbol" />
    </view>

    <view class="form-grid">
      <view class="form-item form-half">
        <view class="form-label">开始日期</view>
        <input class="form-input" type="text" value="{{startDate}}" placeholder="YYYYMMDD" bindinput="onInputStartDate" />
      </view>
      <view class="form-item form-half">
        <view class="form-label">结束日期</view>
        <input class="form-input" type="text" value="{{endDate}}" placeholder="YYYYMMDD" bindinput="onInputEndDate" />
      </view>
    </view>

    <view class="form-item">
      <view class="form-label">策略选择</view>
      <picker mode="selector" range="{{strategyOptions}}" value="{{strategyIndex}}" bindchange="onChangeStrategy">
        <view class="picker-box">{{strategyOptions[strategyIndex]}}</view>
      </picker>
    </view>

    <view class="strategy-tip-card">
      <view class="strategy-tip-title">当前策略说明</view>
      <view class="strategy-tip-text">原理：{{strategyExplanation.principle}}</view>
      <view class="strategy-tip-text">适用行情：{{strategyExplanation.market}}</view>
      <view class="strategy-tip-text">失效场景：{{strategyExplanation.failure}}</view>
      <view class="strategy-tip-text">学习重点：{{strategyExplanation.focus}}</view>
    </view>

    <view class="form-grid">
      <view class="form-item form-half">
        <view class="form-label">初始资金</view>
        <input class="form-input" type="digit" value="{{initialCash}}" bindinput="onInputInitialCash" />
      </view>
      <view class="form-item form-half">
        <view class="form-label">手续费</view>
        <input class="form-input" type="digit" value="{{commissionRate}}" bindinput="onInputCommissionRate" />
      </view>
    </view>

    <view class="form-item">
      <view class="form-label">滑点</view>
      <input class="form-input" type="digit" value="{{slippageRate}}" bindinput="onInputSlippageRate" />
    </view>

    <block wx:if="{{strategyOptions[strategyIndex] === '双均线策略'}}">
      <view class="param-card">
        <view class="param-title">双均线参数</view>
        <view class="form-grid">
          <view class="form-item form-half">
            <view class="form-label">short_window</view>
            <input class="form-input" type="number" value="{{shortWindow}}" bindinput="onInputShortWindow" />
          </view>
          <view class="form-item form-half">
            <view class="form-label">long_window</view>
            <input class="form-input" type="number" value="{{longWindow}}" bindinput="onInputLongWindow" />
          </view>
        </view>
      </view>
    </block>

    <button class="primary-button" bindtap="startBacktest" loading="{{loading}}" disabled="{{loading}}">
      {{loading ? '回测中...' : '开始回测'}}
    </button>

    <button class="secondary-button" bindtap="testHealth">测试后端连接</button>

    <view wx:if="{{errorMessage}}" class="error-box">
      {{errorMessage}}
    </view>
  </view>

  <view wx:if="{{result}}" class="card summary-card">
    <view class="section-title">回测摘要</view>
    <view class="summary-row"><text class="summary-label">股票代码</text><text class="summary-value">{{summary.symbol}}</text></view>
    <view class="summary-row"><text class="summary-label">回测区间</text><text class="summary-value">{{summary.dateRange}}</text></view>
    <view class="summary-row"><text class="summary-label">策略名称</text><text class="summary-value">{{summary.strategy}}</text></view>
    <view class="summary-row"><text class="summary-label">数据来源</text><text class="{{sourceBadgeClass}}">{{summary.dataSourceLabel}}</text></view>
    <view class="summary-message">{{summary.dataMessage}}</view>
  </view>

  <view wx:if="{{showRealNotice}}" class="card source-note-card source-note-real">
    <view class="source-note-text">当前使用真实历史行情数据。</view>
  </view>

  <view wx:if="{{showCacheNotice}}" class="card source-note-card source-note-cache">
    <view class="source-note-text">当前使用缓存真实行情数据，可能不是最新数据。</view>
  </view>

  <view wx:if="{{showMockNotice}}" class="card source-note-card source-note-mock">
    <view class="source-note-text">当前结果基于模拟行情，仅用于功能演示，不构成真实投资分析。</view>
  </view>

  <view wx:if="{{showErrorCard}}" class="card error-state-card">
    <view class="section-title">{{errorCardTitle}}</view>
    <view class="error-state-text">{{errorCardMessage}}</view>
    <view wx:if="{{failureAnalysis}}" class="failure-analysis">
      <view class="failure-title">失败原因</view>
      <view class="failure-text">{{failureAnalysis.reason}}</view>
      <view class="failure-title">可能原因</view>
      <view wx:for="{{failureAnalysis.possible_causes}}" wx:key="index" class="failure-bullet">- {{item}}</view>
      <view class="failure-title">解决建议</view>
      <view wx:for="{{failureAnalysis.suggestions}}" wx:key="index" class="failure-bullet">- {{item}}</view>
    </view>
    <button class="warning-button" bindtap="retryWithDemoMode">开启演示模式重试</button>
  </view>

  <view wx:if="{{benchmarkAnalysis}}" class="card">
    <view class="section-title">基准收益对比</view>
    <view class="compare-grid">
      <view class="compare-item">
        <view class="compare-label">策略收益</view>
        <view class="compare-value">{{benchmarkAnalysis.strategyReturn}}</view>
      </view>
      <view class="compare-item">
        <view class="compare-label">基准收益</view>
        <view class="compare-value">{{benchmarkAnalysis.benchmarkReturn}}</view>
      </view>
      <view class="compare-item">
        <view class="compare-label">超额收益</view>
        <view class="compare-value">{{benchmarkAnalysis.excessReturn}}</view>
      </view>
    </view>
    <view class="compare-conclusion">{{benchmarkAnalysis.conclusion}}</view>
    <view class="compare-explanation">{{benchmarkAnalysis.explanation}}</view>
  </view>

  <view wx:if="{{displayMetrics.length > 0}}" class="card">
    <view class="section-title">核心指标</view>
    <view class="metrics-grid">
      <view wx:for="{{displayMetrics}}" wx:key="name" class="metric-card">
        <view class="metric-label">{{item.name}}</view>
        <view class="metric-value {{item.toneClass}}">{{item.value}}</view>
      </view>
    </view>
  </view>

  <view wx:if="{{result && !showErrorCard}}" class="card">
    <view class="section-title">净值曲线概览</view>
    <canvas
      wx:if="{{equityCurveLength > 1}}"
      canvas-id="equityCanvas"
      class="equity-canvas"
      style="width: {{equityCanvasWidth}}px; height: {{equityCanvasHeight}}px;"
    ></canvas>
    <view class="curve-summary-grid">
      <view class="curve-summary-item"><view class="curve-label">数据点</view><view class="curve-value">{{equityCurveLength}}</view></view>
      <view class="curve-summary-item"><view class="curve-label">初始净值</view><view class="curve-value">{{curveSummary.first}}</view></view>
      <view class="curve-summary-item"><view class="curve-label">最新净值</view><view class="curve-value">{{curveSummary.last}}</view></view>
      <view class="curve-summary-item"><view class="curve-label">区间变化</view><view class="curve-value">{{curveSummary.change}}</view></view>
      <view class="curve-summary-item"><view class="curve-label">最高净值</view><view class="curve-value">{{curveSummary.max}}</view></view>
      <view class="curve-summary-item"><view class="curve-label">最低净值</view><view class="curve-value">{{curveSummary.min}}</view></view>
    </view>

    <view wx:if="{{curvePreview.length > 0}}" class="curve-preview">
      <view wx:for="{{curvePreview}}" wx:key="label" class="curve-bar-row">
        <view class="curve-bar-label">{{item.label}}</view>
        <view class="curve-bar-track"><view class="curve-bar-fill" style="{{item.style}}"></view></view>
        <view class="curve-bar-value">{{item.value}}</view>
      </view>
    </view>
    <view wx:if="{{curvePreview.length === 0}}" class="empty-text">暂无净值曲线明细，仅返回数据点数量。</view>
  </view>

  <view wx:if="{{analysisConclusion}}" class="card">
    <view class="section-title">回测结论</view>
    <view class="analysis-block">
      <view class="analysis-title">总体结论</view>
      <view class="analysis-text">{{analysisConclusion.summary}}</view>
    </view>
    <view class="analysis-block">
      <view class="analysis-title">收益分析</view>
      <view class="analysis-text">{{analysisConclusion.return_analysis}}</view>
    </view>
    <view class="analysis-block">
      <view class="analysis-title">风险分析</view>
      <view class="analysis-text">{{analysisConclusion.risk_analysis}}</view>
    </view>
    <view class="analysis-block">
      <view class="analysis-title">策略局限</view>
      <view class="analysis-text">{{analysisConclusion.strategy_limitation}}</view>
    </view>
    <view class="analysis-block">
      <view class="analysis-title">学习提示</view>
      <view class="analysis-text">{{analysisConclusion.learning_note}}</view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">策略解释</view>
    <view class="strategy-tip-text">原理：{{strategyExplanation.principle}}</view>
    <view class="strategy-tip-text">适用行情：{{strategyExplanation.market}}</view>
    <view class="strategy-tip-text">失效场景：{{strategyExplanation.failure}}</view>
    <view class="strategy-tip-text">学习重点：{{strategyExplanation.focus}}</view>
    <view class="strategy-boundary">本策略适用边界：{{strategyExplanation.market}}；若市场进入{{strategyExplanation.failure}}</view>
  </view>

  <view wx:if="{{result && !showErrorCard}}" class="card">
    <view class="section-title">风险提示</view>
    <block wx:if="{{riskReport.length > 0}}">
      <view wx:for="{{riskReport}}" wx:key="index" class="risk-item">{{item}}</view>
    </block>
    <view wx:if="{{riskReport.length === 0}}" class="empty-text">暂无风险提示。</view>
  </view>

  <view class="card">
    <view class="section-title">参数敏感性分析</view>
    <button class="secondary-button" bindtap="runSensitivityAnalysis" loading="{{sensitivityLoading}}" disabled="{{sensitivityLoading}}">
      {{sensitivityLoading ? '分析中...' : '参数敏感性分析'}}
    </button>

    <view wx:if="{{sensitivitySummary}}" class="sensitivity-summary">
      <view class="sensitivity-text">影响程度：{{sensitivitySummary.is_sensitive ? '较敏感' : '相对稳定'}}</view>
      <view class="sensitivity-text">表现较优组合：{{sensitivitySummary.best_params}}</view>
      <view class="sensitivity-text">表现较弱组合：{{sensitivitySummary.worst_params}}</view>
      <view class="sensitivity-text">{{sensitivitySummary.explanation}}</view>
    </view>

    <view wx:if="{{sensitivityResults.length > 0}}" class="sensitivity-list">
      <view wx:for="{{sensitivityResults}}" wx:key="params_label" class="sensitivity-item">
        <view class="sensitivity-label">{{item.params_label}}</view>
        <view class="sensitivity-metrics">收益率：{{item.total_return * 100}}%</view>
        <view class="sensitivity-metrics">最大回撤：{{item.max_drawdown * 100}}%</view>
        <view class="sensitivity-metrics">夏普比率：{{item.sharpe_ratio}}</view>
        <view class="sensitivity-metrics">{{item.conclusion}}</view>
      </view>
    </view>

    <view wx:if="{{sensitivityVisuals.length > 0}}" class="sensitivity-chart">
      <view wx:for="{{sensitivityVisuals}}" wx:key="paramsLabel" class="sensitivity-chart-row">
        <view class="sensitivity-chart-header">
          <text class="sensitivity-chart-label">{{item.paramsLabel}}</text>
          <text class="sensitivity-chart-value">{{item.totalReturnText}}</text>
        </view>
        <view class="sensitivity-bar-track">
          <view class="{{item.barClass}}" style="{{item.barStyle}}"></view>
        </view>
        <view class="sensitivity-chart-meta">最大回撤：{{item.maxDrawdownText}} ｜ 夏普：{{item.sharpeText}}</view>
        <view class="sensitivity-chart-meta">{{item.conclusion}}</view>
      </view>
    </view>
  </view>

  <view wx:if="{{reportText}}" class="card">
    <view class="section-title">中文分析报告</view>
    <view class="report-box">{{reportText}}</view>
    <button class="ghost-button" bindtap="copyReport">复制分析报告</button>
  </view>

  <view wx:if="{{trades.length > 0 && !showErrorCard}}" class="card">
    <view class="section-title">交易记录（前 10 条）</view>
    <scroll-view scroll-x class="trade-scroll">
      <view class="trade-table">
        <view class="trade-header trade-row">
          <view class="trade-cell">买入日期</view>
          <view class="trade-cell">卖出日期</view>
          <view class="trade-cell">买入价</view>
          <view class="trade-cell">卖出价</view>
          <view class="trade-cell">收益</view>
        </view>
        <view wx:for="{{trades}}" wx:key="index" class="trade-row">
          <view class="trade-cell">{{item.buy_date}}</view>
          <view class="trade-cell">{{item.sell_date}}</view>
          <view class="trade-cell">{{item.buy_price}}</view>
          <view class="trade-cell">{{item.sell_price}}</view>
          <view class="trade-cell">{{item.profit}}</view>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="card disclaimer-card">
    <view class="section-title">免责声明</view>
    <view class="disclaimer-text">{{disclaimerText}}</view>
  </view>
</view>
