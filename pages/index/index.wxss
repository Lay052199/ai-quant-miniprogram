.hero-card {
  background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 55%, #2563eb 100%);
  border-radius: 28rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 20rpx 50rpx rgba(15, 23, 42, 0.2);
}

.hero-title {
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.hero-desc {
  color: rgba(255, 255, 255, 0.84);
  font-size: 24rpx;
  line-height: 1.6;
}

.form-item {
  margin-bottom: 20rpx;
}

.form-grid {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.form-half {
  flex: 1;
}

.form-label {
  font-size: 26rpx;
  color: #334155;
  margin-bottom: 12rpx;
  font-weight: 600;
}

.form-input,
.picker-box {
  background: #f8fafc;
  border: 2rpx solid #dbe5f0;
  border-radius: 18rpx;
  min-height: 84rpx;
  padding: 0 22rpx;
  font-size: 28rpx;
  color: #0f172a;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.picker-box {
  line-height: 84rpx;
}

.param-card,
.strategy-tip-card {
  background: #f8fbff;
  border: 2rpx solid #d7e6fb;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
}

.param-title,
.strategy-tip-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1e3a8a;
  margin-bottom: 16rpx;
}

.strategy-tip-text,
.strategy-boundary {
  font-size: 25rpx;
  color: #334155;
  line-height: 1.8;
  margin-bottom: 10rpx;
}

.primary-button {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #1d4ed8 0%, #2563eb 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  margin-top: 12rpx;
}

.primary-button::after {
  border: none;
}

.secondary-button {
  margin-top: 18rpx;
  border-radius: 18rpx;
  background: #eef4ff;
  color: #1d4ed8;
  font-size: 26rpx;
  border: 2rpx solid #cdddff;
}

.secondary-button::after {
  border: none;
}

.ghost-button {
  margin-top: 20rpx;
  border-radius: 18rpx;
  background: #f8fafc;
  color: #475569;
  font-size: 26rpx;
  border: 2rpx solid #dbe5f0;
}

.ghost-button::after {
  border: none;
}

.warning-button {
  margin-top: 24rpx;
  border-radius: 18rpx;
  background: #fff7ed;
  color: #c2410c;
  font-size: 26rpx;
  border: 2rpx solid #fdba74;
}

.warning-button::after {
  border: none;
}

.error-box {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #fef2f2;
  color: #b91c1c;
  font-size: 26rpx;
  line-height: 1.6;
}

.summary-card {
  background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
}

.summary-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #eef2f7;
}

.summary-row:last-child {
  border-bottom: none;
}

.summary-label {
  font-size: 25rpx;
  color: #64748b;
}

.summary-value {
  font-size: 26rpx;
  color: #0f172a;
  font-weight: 600;
  text-align: right;
}

.summary-message {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #f8fafc;
  color: #475569;
  font-size: 25rpx;
  line-height: 1.7;
}

.source-badge {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.source-akshare {
  background: #dcfce7;
  color: #166534;
}

.source-cache {
  background: #dbeafe;
  color: #1d4ed8;
}

.source-mock {
  background: #fff7ed;
  color: #c2410c;
}

.source-none {
  background: #f1f5f9;
  color: #64748b;
}

.source-note-card {
  padding: 20rpx 24rpx;
}

.source-note-real {
  border-left: 8rpx solid #16a34a;
}

.source-note-cache {
  border-left: 8rpx solid #2563eb;
}

.source-note-mock {
  border-left: 8rpx solid #f97316;
  background: linear-gradient(180deg, #fff7ed 0%, #fffbeb 100%);
}

.source-note-text {
  font-size: 25rpx;
  line-height: 1.8;
  color: #334155;
}

.error-state-card {
  border: 2rpx solid #fecaca;
  background: linear-gradient(180deg, #fff1f2 0%, #fff7f7 100%);
}

.error-state-text {
  color: #b91c1c;
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.failure-analysis {
  margin-top: 14rpx;
}

.failure-title {
  font-size: 25rpx;
  font-weight: 700;
  color: #7f1d1d;
  margin-top: 14rpx;
  margin-bottom: 8rpx;
}

.failure-text,
.failure-bullet {
  font-size: 24rpx;
  color: #7f1d1d;
  line-height: 1.8;
}

.metrics-grid,
.compare-grid,
.curve-summary-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.metric-card,
.compare-item,
.curve-summary-item,
.sensitivity-item {
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid #e5e7eb;
}

.metric-label,
.compare-label,
.curve-label {
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 8rpx;
}

.metric-value,
.compare-value,
.curve-value {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
  word-break: break-all;
}

.metric-positive {
  color: #15803d;
}

.metric-negative {
  color: #dc2626;
}

.compare-conclusion {
  margin-top: 18rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #1d4ed8;
}

.compare-explanation {
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.8;
  color: #334155;
}

.curve-preview {
  margin-top: 24rpx;
}

.equity-canvas {
  width: 100%;
  border-radius: 18rpx;
  background: #ffffff;
  margin-bottom: 20rpx;
}

.curve-bar-row {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}

.curve-bar-label {
  width: 70rpx;
  font-size: 22rpx;
  color: #64748b;
}

.curve-bar-track {
  flex: 1;
  height: 16rpx;
  border-radius: 999rpx;
  background: #e5e7eb;
  overflow: hidden;
  margin: 0 12rpx;
}

.curve-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #2563eb, #38bdf8);
}

.curve-bar-value {
  width: 100rpx;
  text-align: right;
  font-size: 22rpx;
  color: #334155;
}

.analysis-block {
  margin-bottom: 18rpx;
}

.analysis-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 8rpx;
}

.analysis-text,
.sensitivity-text {
  font-size: 25rpx;
  line-height: 1.8;
  color: #334155;
}

.risk-item {
  font-size: 26rpx;
  color: #334155;
  line-height: 1.8;
  margin-bottom: 10rpx;
  padding-left: 8rpx;
  border-left: 6rpx solid #f59e0b;
}

.sensitivity-summary {
  margin-top: 20rpx;
}

.sensitivity-list {
  margin-top: 18rpx;
}

.sensitivity-chart {
  margin-top: 24rpx;
}

.sensitivity-chart-row {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #e5e7eb;
}

.sensitivity-chart-row:last-child {
  border-bottom: none;
}

.sensitivity-chart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.sensitivity-chart-label {
  font-size: 25rpx;
  font-weight: 700;
  color: #0f172a;
}

.sensitivity-chart-value {
  font-size: 24rpx;
  font-weight: 700;
  color: #1d4ed8;
}

.sensitivity-bar-track {
  width: 100%;
  height: 16rpx;
  background: #e5e7eb;
  border-radius: 999rpx;
  overflow: hidden;
  margin-bottom: 10rpx;
}

.sensitivity-bar-fill {
  height: 100%;
  border-radius: 999rpx;
}

.sensitivity-bar-fill.positive {
  background: linear-gradient(90deg, #16a34a, #4ade80);
}

.sensitivity-bar-fill.negative {
  background: linear-gradient(90deg, #ef4444, #f97316);
}

.sensitivity-chart-meta {
  font-size: 23rpx;
  color: #64748b;
  line-height: 1.7;
}

.sensitivity-label {
  font-size: 26rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 8rpx;
}

.sensitivity-metrics {
  font-size: 24rpx;
  color: #475569;
  line-height: 1.7;
}

.report-box {
  white-space: pre-wrap;
  font-size: 26rpx;
  color: #1e293b;
  line-height: 1.8;
}

.trade-scroll {
  width: 100%;
}

.trade-table {
  min-width: 920rpx;
}

.trade-row {
  display: flex;
  border-bottom: 2rpx solid #e2e8f0;
}

.trade-header {
  background: #eff6ff;
}

.trade-cell {
  width: 184rpx;
  padding: 18rpx 14rpx;
  font-size: 24rpx;
  color: #1e293b;
  box-sizing: border-box;
  flex-shrink: 0;
}

.disclaimer-card {
  background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
  border: 1rpx dashed #cbd5e1;
}

.disclaimer-text {
  font-size: 24rpx;
  color: #475569;
  line-height: 1.8;
}

.empty-text {
  font-size: 26rpx;
  color: #64748b;
}
