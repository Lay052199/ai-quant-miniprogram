.profile-page { min-height:100vh; padding:24rpx; background:linear-gradient(180deg,#f5f7ff,#eef3ff); }
.profile-hero { display:flex; align-items:center; gap:20rpx; padding:36rpx; border-radius:28rpx; color:#fff; background:linear-gradient(120deg,#347ff4,#7751e9); }.logo { display:flex; align-items:center; justify-content:center; width:84rpx; height:84rpx; border-radius:24rpx; background:rgba(255,255,255,.2); font-size:44rpx; font-weight:700; }.profile-hero text { font-size:34rpx; font-weight:700; }.profile-hero view view { margin-top:6rpx; font-size:22rpx; opacity:.85; }
.info-card { margin-top:20rpx; padding:26rpx; border:1rpx solid #e1e6f5; border-radius:24rpx; background:#fff; box-shadow:0 12rpx 30rpx rgba(50,66,142,.07); }.title { margin-bottom:16rpx; color:#151e3d; font-size:29rpx; font-weight:700; }.paragraph { color:#65708e; font-size:24rpx; line-height:1.75; }.row { display:flex; justify-content:space-between; gap:20rpx; padding:12rpx 0; color:#5e6988; font-size:23rpx; border-bottom:1rpx solid #edf0f8; }.info-card button { margin-top:18rpx; border:0; border-radius:16rpx; color:#5263f5; background:#eef1ff; font-size:24rpx; }.info-card button::after { border:0; }
