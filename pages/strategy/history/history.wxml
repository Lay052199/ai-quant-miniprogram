<view class="history-page">
  <image class="history-background" src="/assets/backgrounds/home-bg.jpg" mode="aspectFill"></image>
  <view class="history-glow glow-a"></view>
  <view class="history-glow glow-b"></view>

  <view class="history-header">
    <button class="back-button" bindtap="goBack"><view class="back-chevron"></view></button>
    <view class="history-title">最近使用</view>
    <button class="clear-button" bindtap="clearHistory">
      <text>清空记录</text>
      <image class="clear-icon" src="/assets/strategy/icons/trash.svg" mode="aspectFit"></image>
    </button>
  </view>

  <view class="search-sort-row">
    <view class="history-search">
      <image class="search-icon" src="/assets/icons/search.svg" mode="aspectFit"></image>
      <input class="history-search-input" value="{{query}}" placeholder="搜索策略名称或关键词" placeholder-class="history-placeholder" bindinput="onSearchInput" />
    </view>
    <button class="sort-button" bindtap="onSortTap">
      <image class="sort-icon" src="/assets/strategy/icons/sort.svg" mode="aspectFit"></image>
      <text>{{sortLabel}}</text>
      <view class="sort-chevron"></view>
    </button>
  </view>

  <view class="period-tabs">
    <view class="period-tab {{selectedPeriod === period.key ? 'active' : ''}}" wx:for="{{periods}}" wx:key="key" wx:for-item="period" data-key="{{period.key}}" bindtap="onPeriodTap">{{period.label}}</view>
  </view>

  <view wx:if="{{visibleGroups.length}}" class="history-groups">
    <view class="history-group" wx:for="{{visibleGroups}}" wx:key="key" wx:for-item="group">
      <view class="group-title">{{group.label}}</view>
      <view class="history-record-card" wx:for="{{group.records}}" wx:key="id" wx:for-item="record" data-id="{{record.id}}" bindtap="openStrategy">
        <image class="record-icon" src="{{record.icon}}" mode="aspectFit"></image>
        <view class="record-main">
          <view class="record-name-row">
            <text class="record-name">{{record.name}}</text>
            <text class="risk-badge {{record.riskTone}}">{{record.risk}}</text>
          </view>
          <view class="record-description">{{record.description}}</view>
          <view class="record-tags">
            <text class="record-tag" wx:for="{{record.tags}}" wx:key="*this" wx:for-item="tag">{{tag}}</text>
          </view>
        </view>
        <view class="record-side">
          <view class="record-times">
            <view class="record-time-line"><text>上次查看</text><text>{{record.lastView}}</text></view>
            <view class="record-time-line"><text>最近回测</text><text>{{record.lastBacktest}}</text></view>
          </view>
          <view class="side-divider"></view>
          <button class="continue-button" data-id="{{record.id}}" catchtap="continueStrategy">
            <view class="play-circle"><view class="play-triangle"></view></view>
            <text>继续使用</text>
          </button>
        </view>
      </view>
    </view>
  </view>

  <view wx:else class="history-empty">
    <view class="empty-orbit">
      <view class="empty-inner-orbit"></view>
      <view class="empty-dot"></view>
    </view>
    <view class="empty-title">暂无最近使用记录</view>
    <view class="empty-copy">选择一个策略开始回测后，记录会保存在这里。</view>
  </view>

  <view class="history-summary">
    <view>共 {{visibleCount}} 条记录</view>
    <view class="privacy-note">
      <image class="shield-icon" src="/assets/strategy/icons/shield.svg" mode="aspectFit"></image>
      <text>记录仅保存在本地，不会同步到云端</text>
    </view>
  </view>

  <view class="history-tabbar">
    <view class="history-tab-item" data-url="/pages/backtest/backtest" bindtap="switchMainTab">
      <image class="history-tab-icon" src="/assets/tab/home.png" mode="aspectFit"></image>
      <text>回测</text>
    </view>
    <view class="history-tab-item" data-url="/pages/results/results" bindtap="switchMainTab">
      <image class="history-tab-icon" src="/assets/tab/result.png" mode="aspectFit"></image>
      <text>结果</text>
    </view>
    <view class="history-tab-item active" data-url="/pages/strategies/strategies" bindtap="switchMainTab">
      <image class="history-tab-icon" src="/assets/tab/strategy-active.png" mode="aspectFit"></image>
      <text>策略</text>
    </view>
    <view class="history-tab-item" data-url="/pages/profile/profile" bindtap="switchMainTab">
      <image class="history-tab-icon" src="/assets/tab/profile.png" mode="aspectFit"></image>
      <text>我的</text>
    </view>
  </view>
</view>
