.history-page {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
  overflow: hidden;
  padding: 22rpx 24rpx 190rpx;
  color: #172554;
  background: linear-gradient(180deg, #f5f7ff 0%, #eef2ff 50%, #f8f9ff 100%);
}

.history-background {
  position: absolute;
  z-index: 0;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0.4;
  pointer-events: none;
}

.history-glow {
  position: absolute;
  z-index: 0;
  width: 420rpx;
  height: 420rpx;
  border-radius: 50%;
  filter: blur(46rpx);
  pointer-events: none;
}

.glow-a {
  top: 280rpx;
  left: -270rpx;
  background: rgba(78, 126, 255, 0.12);
}

.glow-b {
  top: 1280rpx;
  right: -250rpx;
  background: rgba(139, 92, 246, 0.12);
}

.history-header,
.search-sort-row,
.period-tabs,
.history-groups,
.history-empty,
.history-summary {
  position: relative;
  z-index: 2;
}

.history-header {
  display: grid;
  grid-template-columns: 170rpx 1fr 170rpx;
  height: 86rpx;
  align-items: center;
}

.history-title {
  color: #172554;
  font-size: 34rpx;
  font-weight: 800;
  text-align: center;
}

.back-button,
.clear-button,
.sort-button,
.continue-button {
  margin: 0;
  padding: 0;
  background: transparent;
  line-height: normal;
}

.back-button {
  display: flex;
  width: 62rpx;
  height: 62rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(207, 216, 244, 0.65);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.58);
  box-shadow: 0 8rpx 22rpx rgba(74, 89, 168, 0.07);
}

.back-chevron {
  width: 17rpx;
  height: 17rpx;
  margin-left: 7rpx;
  transform: rotate(45deg);
  border-bottom: 4rpx solid #7185c5;
  border-left: 4rpx solid #7185c5;
  border-radius: 2rpx;
}

.clear-button {
  display: flex;
  height: 62rpx;
  align-items: center;
  justify-content: flex-end;
  gap: 7rpx;
  color: #526dff;
  font-size: 20rpx;
  font-weight: 600;
}

.clear-icon {
  width: 28rpx;
  height: 28rpx;
}

.search-sort-row {
  display: flex;
  margin-top: 8rpx;
  align-items: center;
  gap: 14rpx;
}

.history-search,
.sort-button {
  height: 72rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(220, 227, 250, 0.8);
  background: rgba(255, 255, 255, 0.78);
  box-shadow: 0 10rpx 26rpx rgba(80, 100, 200, 0.08), inset 0 2rpx 0 rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
}

.history-search {
  display: flex;
  min-width: 0;
  flex: 1;
  align-items: center;
  padding: 0 22rpx;
  border-radius: 36rpx;
}

.search-icon {
  width: 31rpx;
  height: 31rpx;
  flex: 0 0 31rpx;
}

.history-search-input {
  min-width: 0;
  height: 100%;
  flex: 1;
  margin-left: 13rpx;
  color: #2f3a5d;
  font-size: 21rpx;
}

.history-placeholder {
  color: #91a0c5;
}

.sort-button {
  display: flex;
  width: 202rpx;
  flex: 0 0 202rpx;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border-radius: 22rpx;
  color: #687ba9;
  font-size: 18rpx;
  font-weight: 550;
  white-space: nowrap;
}

.sort-icon {
  width: 28rpx;
  height: 28rpx;
}

.sort-chevron {
  width: 10rpx;
  height: 10rpx;
  margin-top: -5rpx;
  transform: rotate(-45deg);
  border-bottom: 2rpx solid #8291b6;
  border-left: 2rpx solid #8291b6;
}

.period-tabs {
  display: flex;
  margin-top: 23rpx;
  align-items: center;
  gap: 17rpx;
}

.period-tab {
  display: flex;
  min-width: 123rpx;
  height: 60rpx;
  box-sizing: border-box;
  padding: 0 26rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(218, 225, 246, 0.85);
  border-radius: 30rpx;
  color: #64759f;
  background: rgba(255, 255, 255, 0.56);
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.88);
  font-size: 21rpx;
  font-weight: 600;
}

.period-tab.active {
  border-color: transparent;
  color: #ffffff;
  background: linear-gradient(135deg, #4568ff, #8b5cf6);
  box-shadow: 0 10rpx 25rpx rgba(84, 93, 235, 0.24), inset 0 2rpx 0 rgba(255, 255, 255, 0.24);
}

.history-groups {
  margin-top: 27rpx;
}

.history-group {
  margin-top: 28rpx;
}

.group-title {
  margin: 0 4rpx 13rpx;
  color: #1e293b;
  font-size: 28rpx;
  font-weight: 800;
}

.history-record-card {
  display: flex;
  min-height: 166rpx;
  margin-top: 13rpx;
  box-sizing: border-box;
  padding: 20rpx 18rpx 20rpx 20rpx;
  align-items: center;
  gap: 17rpx;
  border: 2rpx solid rgba(222, 228, 248, 0.82);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.84);
  box-shadow: 0 12rpx 34rpx rgba(80, 90, 200, 0.09), inset 0 2rpx 0 rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
}

.record-icon {
  width: 80rpx;
  height: 80rpx;
  flex: 0 0 80rpx;
  border-radius: 20rpx;
  box-shadow: 0 10rpx 22rpx rgba(88, 79, 222, 0.18);
}

.record-main {
  min-width: 0;
  flex: 1;
}

.record-name-row {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 9rpx;
}

.record-name {
  overflow: hidden;
  color: #172144;
  font-size: 27rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.risk-badge {
  display: inline-flex;
  height: 31rpx;
  flex: 0 0 auto;
  box-sizing: border-box;
  padding: 0 10rpx;
  align-items: center;
  border-radius: 999rpx;
  font-size: 15rpx;
  font-weight: 650;
  line-height: 31rpx;
}

.low-risk {
  color: #4670df;
  background: #eaf1ff;
}

.medium-risk {
  color: #c9781f;
  background: #fff1dc;
}

.high-risk {
  color: #df5663;
  background: #ffeaed;
}

.record-description {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 9rpx;
  color: #64748b;
  font-size: 18rpx;
  line-height: 1.45;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.record-tags {
  display: flex;
  margin-top: 10rpx;
  flex-wrap: wrap;
  gap: 6rpx;
}

.record-tag {
  display: inline-flex;
  height: 29rpx;
  padding: 0 9rpx;
  align-items: center;
  border-radius: 10rpx;
  color: #6571d7;
  background: #eef2ff;
  font-size: 14rpx;
  line-height: 29rpx;
}

.record-side {
  display: flex;
  width: 230rpx;
  flex: 0 0 230rpx;
  align-items: center;
}

.record-times {
  min-width: 0;
  flex: 1;
}

.record-time-line {
  display: flex;
  margin-top: 7rpx;
  align-items: center;
  justify-content: space-between;
  gap: 9rpx;
  color: #94a3b8;
  font-size: 15rpx;
  white-space: nowrap;
}

.side-divider {
  width: 2rpx;
  height: 72rpx;
  margin: 0 13rpx;
  background: rgba(220, 227, 247, 0.9);
}

.continue-button {
  display: flex;
  width: 74rpx;
  flex: 0 0 74rpx;
  flex-direction: column;
  align-items: center;
  color: #526dff;
  font-size: 14rpx;
  font-weight: 600;
  gap: 6rpx;
}

.play-circle {
  display: flex;
  width: 54rpx;
  height: 54rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #dce3ff;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.76);
  box-shadow: 0 7rpx 18rpx rgba(77, 102, 222, 0.08);
}

.play-triangle {
  width: 0;
  height: 0;
  margin-left: 5rpx;
  border-top: 11rpx solid transparent;
  border-bottom: 11rpx solid transparent;
  border-left: 17rpx solid #526dff;
}

.history-empty {
  margin-top: 45rpx;
  padding: 70rpx 30rpx;
  border: 2rpx solid rgba(221, 228, 248, 0.8);
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 14rpx 38rpx rgba(80, 90, 200, 0.08);
  text-align: center;
}

.empty-orbit {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  margin: 0 auto;
  border: 3rpx solid rgba(93, 104, 239, 0.28);
  border-radius: 50%;
}

.empty-inner-orbit {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  width: 50rpx;
  height: 50rpx;
  border: 3rpx solid rgba(139, 92, 246, 0.28);
  border-radius: 50%;
}

.empty-dot {
  position: absolute;
  z-index: 2;
  top: -5rpx;
  left: 36rpx;
  width: 15rpx;
  height: 15rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #526dff, #9a67f4);
  box-shadow: 0 4rpx 12rpx rgba(82, 109, 255, 0.35);
}

.empty-title {
  margin-top: 20rpx;
  color: #2d395d;
  font-size: 25rpx;
  font-weight: 750;
}

.empty-copy {
  margin-top: 8rpx;
  color: #8b97b4;
  font-size: 18rpx;
}

.history-summary {
  padding: 34rpx 0 8rpx;
  color: #7483aa;
  font-size: 19rpx;
  text-align: center;
}

.privacy-note {
  display: flex;
  margin-top: 10rpx;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
  color: #95a4c8;
  font-size: 17rpx;
}

.shield-icon {
  width: 25rpx;
  height: 25rpx;
}

.history-tabbar {
  position: fixed;
  z-index: 20;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  height: 126rpx;
  box-sizing: border-box;
  padding: 15rpx 36rpx 14rpx;
  align-items: flex-start;
  justify-content: space-between;
  border-top: 2rpx solid rgba(220, 226, 244, 0.82);
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 -12rpx 36rpx rgba(68, 79, 148, 0.08);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
}

.history-tab-item {
  display: flex;
  width: 122rpx;
  flex-direction: column;
  align-items: center;
  color: #7c87a8;
  font-size: 18rpx;
  gap: 4rpx;
}

.history-tab-item.active {
  color: #4263f3;
  font-weight: 650;
}

.history-tab-icon {
  width: 49rpx;
  height: 49rpx;
}

.back-button::after,
.clear-button::after,
.sort-button::after,
.continue-button::after {
  border: 0;
}
