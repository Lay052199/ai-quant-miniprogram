.logic-page {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
  overflow: hidden;
  padding: 8rpx 18rpx 176rpx;
  background: linear-gradient(180deg, #f8faff 0%, #f2f5ff 46%, #f8f7ff 100%);
  color: #172554;
}
.logic-background { position: absolute; z-index: 0; inset: 0; width: 100%; height: 100%; opacity: .14; }
.logic-glow { position: absolute; z-index: 0; border-radius: 50%; filter: blur(64rpx); pointer-events: none; }
.glow-one { right: -180rpx; top: 420rpx; width: 380rpx; height: 380rpx; background: rgba(139, 92, 246, .13); }
.glow-two { left: -180rpx; top: 1280rpx; width: 360rpx; height: 360rpx; background: rgba(76, 125, 255, .1); }
.logic-header, strategy-header, .analysis-stack, .logic-error, .sticky-action { position: relative; z-index: 2; }
.logic-header { display: flex; height: 82rpx; align-items: center; justify-content: space-between; }
.logic-title-wrap { display: flex; align-items: center; gap: 18rpx; }
.logic-title { color: #14245a; font-size: 37rpx; font-weight: 800; letter-spacing: 2rpx; }
.title-line { width: 62rpx; height: 4rpx; border-radius: 9rpx; background: linear-gradient(90deg, transparent, #8067ff); }
.title-line.reverse { transform: rotate(180deg); }
.header-space, .back-button { width: 62rpx; height: 62rpx; }
.back-button { display: flex; margin: 0; padding: 0; align-items: center; justify-content: center; border: 1rpx solid rgba(207, 216, 244, .78); border-radius: 20rpx; background: rgba(255, 255, 255, .68); line-height: normal; }
.back-button::after, .primary-action::after { border: 0; }
.back-chevron { width: 17rpx; height: 17rpx; border-left: 4rpx solid #7185c5; border-bottom: 4rpx solid #7185c5; transform: rotate(45deg); }
.analysis-stack { display: flex; flex-direction: column; gap: 12rpx; margin-top: 12rpx; }
.analysis-section {
  padding: 16rpx 18rpx;
  border: 1rpx solid rgba(139, 154, 219, .2);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, .84);
  box-shadow: 0 10rpx 28rpx rgba(68, 88, 164, .075);
  backdrop-filter: blur(18rpx);
}
.section-title { display: flex; align-items: center; margin-bottom: 12rpx; color: #172554; font-size: 25rpx; font-weight: 760; }
.section-icon { width: 34rpx; height: 34rpx; margin-right: 10rpx; line-height: 34rpx; border-radius: 10rpx; background: linear-gradient(135deg, #e9edff, #f0e8ff); color: #526dff; font-size: 20rpx; text-align: center; }
.logic-grid { display: grid; grid-template-columns: 1.24fr .88fr .88fr; gap: 10rpx; }
.logic-primary-shell { display: flex; min-width: 0; flex-direction: column; gap: 8rpx; }
.parameter-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10rpx; }
.section-hint { display: flex; margin-top: 9rpx; align-items: center; justify-content: center; color: #8794b5; font-size: 17rpx; line-height: 1.45; }
.hint-ai { margin-right: 8rpx; padding: 3rpx 8rpx; border-radius: 999rpx; background: linear-gradient(135deg, #5f78ff, #9865ff); color: #fff; font-size: 14rpx; font-weight: 700; }
.dual-section { display: grid; grid-template-columns: 1.34fr .86fr; gap: 12rpx; }
.mechanism-image { display: block; width: 100%; border-radius: 18rpx; }
.mechanism-legend { display: flex; flex-wrap: wrap; gap: 18rpx; margin-top: 8rpx; color: #6e7c9f; font-size: 17rpx; }
.legend-dot { display: inline-block; width: 16rpx; height: 5rpx; margin-right: 7rpx; border-radius: 5rpx; background: #526dff; vertical-align: middle; }
.dot-1 { background: #9962ff; }.dot-2 { background: #2baa68; }.dot-3 { background: #ef5c74; }
.logic-error { margin-top: 18rpx; padding: 16rpx 20rpx; border-radius: 18rpx; background: #fff0f1; color: #cc5966; font-size: 21rpx; }
.sticky-action { position: fixed; z-index: 20; left: 0; right: 0; bottom: 0; padding: 26rpx 154rpx calc(18rpx + env(safe-area-inset-bottom)); background: linear-gradient(180deg, rgba(246, 248, 255, 0), #f7f9ff 48%); }
.primary-action { height: 76rpx; margin: 0; border: 0; border-radius: 38rpx; background: linear-gradient(110deg, #4c7dff, #765df5 55%, #aa45ee); box-shadow: 0 14rpx 30rpx rgba(91, 89, 235, .28); color: #fff; font-size: 28rpx; font-weight: 800; line-height: 76rpx; }
.play-mark { display: inline-flex; width: 36rpx; height: 36rpx; margin-right: 12rpx; align-items: center; justify-content: center; border-radius: 50%; background: rgba(255, 255, 255, .2); font-size: 15rpx; vertical-align: 2rpx; }
@media (max-width: 380px) {
  .logic-page { padding-left: 14rpx; padding-right: 14rpx; }
  .analysis-section { padding-left: 14rpx; padding-right: 14rpx; }
  .sticky-action { padding-left: 126rpx; padding-right: 126rpx; }
}
