.performance-page{position:relative;box-sizing:border-box;min-height:100vh;padding:20rpx 24rpx 120rpx;overflow:hidden;background:linear-gradient(180deg,#f5f7ff 0%,#eef2ff 50%,#f8f9ff 100%);color:#172554}.performance-background{position:absolute;z-index:0;inset:0;width:100%;height:100%;opacity:.19}.performance-header,.empty-result,.result-overview,.metric-grid,chart-card,.chart-gap,.statistics-card,.performance-error{position:relative;z-index:2}.performance-header{display:flex;height:84rpx;align-items:center;justify-content:space-between}.performance-title{font-size:34rpx;font-weight:800}.header-space,.back-button{width:62rpx;height:62rpx}.back-button{display:flex;margin:0;padding:0;align-items:center;justify-content:center;border:1rpx solid rgba(207,216,244,.7);border-radius:20rpx;background:rgba(255,255,255,.65);line-height:normal}.back-button::after,.empty-action::after{border:0}.back-chevron{width:17rpx;height:17rpx;border-left:4rpx solid #7185c5;border-bottom:4rpx solid #7185c5;transform:rotate(45deg)}.empty-result{margin-top:90rpx;padding:54rpx 34rpx;border:1rpx solid rgba(224,230,251,.84);border-radius:32rpx;background:rgba(255,255,255,.86);box-shadow:0 18rpx 44rpx rgba(78,90,176,.09);text-align:center}.empty-orbit{position:relative;width:94rpx;height:94rpx;margin:0 auto;border:3rpx solid rgba(82,109,255,.22);border-radius:50%}.empty-core{position:absolute;left:23rpx;top:23rpx;width:42rpx;height:42rpx;border-radius:50%;background:linear-gradient(135deg,#526dff,#9a67f4);box-shadow:0 10rpx 24rpx rgba(82,109,255,.28)}.empty-title{margin-top:24rpx;font-size:29rpx;font-weight:800}.empty-copy{margin-top:12rpx;color:#7a87a5;font-size:22rpx;line-height:1.65}.empty-action{height:76rpx;margin:28rpx 0 0;border:0;border-radius:26rpx;background:linear-gradient(110deg,#4c7dff,#8b5cf6);color:#fff;font-size:25rpx;font-weight:750;line-height:76rpx}.result-overview{padding:27rpx 30rpx;border-radius:30rpx;background:linear-gradient(135deg,#4c7dff,#8b5cf6);box-shadow:0 16rpx 38rpx rgba(84,88,210,.2);color:#fff}.overview-eyebrow{font-size:20rpx;opacity:.75;letter-spacing:2rpx}.overview-name{margin-top:7rpx;font-size:31rpx;font-weight:800}.overview-dates{margin-top:9rpx;font-size:21rpx;opacity:.82}.metric-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:13rpx;margin:20rpx 0}.chart-height{height:320rpx}.net-height{height:390rpx}.chart-gap{height:18rpx}.statistics-card{margin-top:20rpx;padding:26rpx;border:1rpx solid rgba(224,230,251,.82);border-radius:28rpx;background:rgba(255,255,255,.88);box-shadow:0 12rpx 32rpx rgba(78,90,176,.08)}.statistics-title{font-size:28rpx;font-weight:780}.statistics-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx;margin-top:18rpx}.statistic-item{padding:18rpx 13rpx;border-radius:19rpx;background:#f5f7ff}.stat-label{color:#8793ae;font-size:19rpx}.stat-value{margin-top:7rpx;color:#172554;font-size:27rpx;font-weight:800}.performance-error{margin-top:18rpx;padding:16rpx 20rpx;border-radius:18rpx;background:#fff0f1;color:#cc5966;font-size:21rpx}
