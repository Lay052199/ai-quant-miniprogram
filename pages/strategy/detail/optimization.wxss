.optimization-page{position:relative;box-sizing:border-box;min-height:100vh;padding:20rpx 24rpx 180rpx;overflow:hidden;background:linear-gradient(180deg,#f5f7ff 0%,#eef2ff 50%,#f8f9ff 100%);color:#172554}.optimization-background{position:absolute;z-index:0;inset:0;width:100%;height:100%;opacity:.19}.optimization-header,strategy-hero,.optimization-stack,.optimization-error,.sticky-action{position:relative;z-index:2}.optimization-header{display:flex;height:84rpx;align-items:center;justify-content:space-between}.optimization-title{font-size:34rpx;font-weight:800}.header-space,.back-button{width:62rpx;height:62rpx}.back-button{display:flex;margin:0;padding:0;align-items:center;justify-content:center;border:1rpx solid rgba(207,216,244,.7);border-radius:20rpx;background:rgba(255,255,255,.65);line-height:normal}.back-button::after,.state-action::after,.apply-action::after,.primary-action::after{border:0}.back-chevron{width:17rpx;height:17rpx;border-left:4rpx solid #7185c5;border-bottom:4rpx solid #7185c5;transform:rotate(45deg)}.optimization-stack{display:flex;flex-direction:column;gap:20rpx;margin-top:22rpx}.current-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:13rpx}.current-cell{padding:18rpx;border:1rpx solid rgba(220,227,249,.82);border-radius:20rpx;background:#f7f9ff}.current-label{color:#8491ac;font-size:20rpx}.current-value{margin-top:6rpx;color:#172554;font-size:29rpx;font-weight:800}.current-value text{font-size:18rpx;font-weight:500}.state-panel{display:flex;min-height:230rpx;flex-direction:column;align-items:center;justify-content:center;text-align:center}.loading-ring{width:48rpx;height:48rpx;margin-bottom:18rpx;border:5rpx solid #e7eafd;border-top-color:#6d68f2;border-radius:50%;animation:spin .9s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}.state-title{color:#2b3959;font-size:25rpx;font-weight:760}.state-copy{max-width:520rpx;margin-top:8rpx;color:#8a96af;font-size:21rpx}.state-action{height:64rpx;margin:20rpx 0 0;padding:0 28rpx;border:0;border-radius:22rpx;background:linear-gradient(110deg,#526dff,#8b5cf6);color:#fff;font-size:22rpx;line-height:64rpx}.state-action.secondary{background:#eef2ff;color:#526dff}.comparison-list{display:flex;flex-direction:column;gap:15rpx}.comparison-row{padding:19rpx;border-radius:21rpx;background:linear-gradient(145deg,#f6f8ff,#f8f5ff)}.comparison-head{display:flex;align-items:center;justify-content:space-between}.comparison-label{font-size:23rpx;font-weight:750}.comparison-return{color:#ef4d55;font-size:25rpx;font-weight:800}.parameter-text{margin-top:5rpx;color:#7b88a5;font-size:19rpx}.comparison-track{height:10rpx;margin-top:13rpx;overflow:hidden;border-radius:8rpx;background:#e9edfa}.comparison-fill{height:100%;border-radius:8rpx;background:linear-gradient(90deg,#526dff,#a66df1)}.comparison-meta{display:flex;justify-content:space-between;margin-top:9rpx;color:#8d98b0;font-size:18rpx}.best-card{position:relative;padding:22rpx;border:1rpx solid rgba(131,109,244,.16);border-radius:23rpx;background:linear-gradient(135deg,rgba(238,242,255,.96),rgba(249,240,255,.94))}.best-badge{display:inline-flex;padding:6rpx 13rpx;border-radius:16rpx;background:#e5e9ff;color:#526dff;font-size:18rpx}.best-title{margin-top:12rpx;font-size:28rpx;font-weight:800}.best-params{margin-top:7rpx;color:#6f7c99;font-size:21rpx}.best-metrics{display:flex;gap:25rpx;margin-top:12rpx;color:#8490aa;font-size:19rpx}.apply-action{height:66rpx;margin:19rpx 0 0;border:1rpx solid #dce3ff;border-radius:22rpx;background:rgba(255,255,255,.85);color:#526dff;font-size:22rpx;line-height:66rpx}.no-best{padding:40rpx 0;text-align:center;color:#94a3b8}.optimization-error{margin-top:18rpx;padding:16rpx 20rpx;border-radius:18rpx;background:#fff0f1;color:#cc5966;font-size:21rpx}.sticky-action{position:fixed;z-index:20;left:0;right:0;bottom:0;padding:18rpx 28rpx calc(22rpx + env(safe-area-inset-bottom));background:linear-gradient(180deg,rgba(246,248,255,0),#f7f9ff 44%)}.primary-action{height:90rpx;margin:0;border:0;border-radius:30rpx;background:linear-gradient(110deg,#4c7dff,#765df5 55%,#aa45ee);box-shadow:0 16rpx 34rpx rgba(91,89,235,.3);color:#fff;font-size:30rpx;font-weight:800;line-height:90rpx}
