.detail-page{position:relative;box-sizing:border-box;min-height:100vh;padding:20rpx 24rpx 190rpx;overflow:hidden;color:#172554;background:linear-gradient(180deg,#f5f7ff 0%,#eef2ff 50%,#f8f9ff 100%)}.detail-background{position:absolute;z-index:0;inset:0;width:100%;height:100%;opacity:.22;pointer-events:none}.detail-glow{position:absolute;z-index:0;width:380rpx;height:380rpx;border-radius:50%;filter:blur(48rpx);pointer-events:none}.glow-a{top:180rpx;left:-250rpx;background:rgba(76,125,255,.15)}.glow-b{top:1120rpx;right:-250rpx;background:rgba(157,123,255,.13)}.detail-header,.fallback-notice,strategy-hero,.section-stack,.detail-nav-grid,.detail-error,.sticky-action{position:relative;z-index:2}.detail-header{display:flex;height:84rpx;align-items:center;justify-content:space-between}.detail-title{font-size:34rpx;font-weight:800}.header-space,.back-button{width:62rpx;height:62rpx}.back-button{display:flex;margin:0;padding:0;align-items:center;justify-content:center;border:1rpx solid rgba(207,216,244,.7);border-radius:20rpx;background:rgba(255,255,255,.65);line-height:normal}.back-button::after,.primary-action::after{border:0}.back-chevron{width:17rpx;height:17rpx;border-left:4rpx solid #7185c5;border-bottom:4rpx solid #7185c5;transform:rotate(45deg)}.fallback-notice{margin-bottom:14rpx;padding:14rpx 20rpx;border-radius:18rpx;background:rgba(255,248,226,.9);color:#a96a1a;font-size:21rpx}.section-stack{display:flex;flex-direction:column;gap:20rpx;margin-top:22rpx}.body-copy{color:#52617b}.tag-cloud{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:17rpx}.soft-tag{padding:7rpx 14rpx;border-radius:18rpx;background:#eef2ff;color:#526dff;font-size:20rpx}.rule-row{display:flex;gap:15rpx;padding:12rpx 0}.rule-index{display:flex;flex:none;width:38rpx;height:38rpx;align-items:center;justify-content:center;border-radius:50%;background:linear-gradient(135deg,#526dff,#8b5cf6);color:#fff;font-size:18rpx}.rule-title{color:#263553;font-size:23rpx;font-weight:700}.rule-copy{margin-top:4rpx;color:#7180a4;font-size:22rpx}.parameter-grid{display:grid;grid-template-columns:1fr 1fr;gap:14rpx}.parameter-cell{padding:18rpx;border:1rpx solid rgba(218,226,250,.8);border-radius:20rpx;background:rgba(247,249,255,.86)}.parameter-label{color:#8090b1;font-size:20rpx}.parameter-value{margin-top:6rpx;color:#172554;font-size:28rpx;font-weight:800}.parameter-value text{font-size:18rpx;font-weight:500}.profile-row{display:flex;align-items:center;gap:12rpx;padding:8rpx 0;color:#5b6882;font-size:22rpx}.profile-dot{width:10rpx;height:10rpx;border-radius:50%;background:#7c6cf2;box-shadow:0 0 0 7rpx rgba(124,108,242,.1)}.detail-nav-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-top:22rpx}.detail-nav-card{position:relative;padding:23rpx;border:1rpx solid rgba(222,228,249,.85);border-radius:26rpx;background:rgba(255,255,255,.84);box-shadow:0 12rpx 30rpx rgba(76,88,170,.08)}.detail-nav-card.wide{grid-column:1 / 3}.nav-icon{display:flex;width:48rpx;height:48rpx;align-items:center;justify-content:center;border-radius:16rpx;background:linear-gradient(135deg,#e8edff,#f1e9ff);color:#526dff;font-size:18rpx;font-weight:800}.nav-title{margin-top:14rpx;font-size:26rpx;font-weight:760}.nav-copy{margin-top:6rpx;color:#8995b1;font-size:20rpx}.nav-arrow{position:absolute;right:21rpx;top:50%;color:#7388c6;font-size:38rpx;transform:translateY(-50%)}.detail-error{margin-top:18rpx;padding:16rpx 20rpx;border-radius:18rpx;background:#fff0f1;color:#cc5966;font-size:21rpx}.sticky-action{position:fixed;z-index:20;left:0;right:0;bottom:0;padding:18rpx 28rpx calc(22rpx + env(safe-area-inset-bottom));background:linear-gradient(180deg,rgba(246,248,255,0),rgba(246,248,255,.9) 24%,#f7f9ff 62%)}.primary-action{display:flex;height:92rpx;margin:0;align-items:center;justify-content:center;gap:14rpx;border:0;border-radius:30rpx;background:linear-gradient(110deg,#4c7dff,#765df5 55%,#aa45ee);box-shadow:0 16rpx 34rpx rgba(91,89,235,.3);color:#fff;font-size:30rpx;font-weight:800;line-height:92rpx}.action-play{display:flex;width:42rpx;height:42rpx;align-items:center;justify-content:center;border-radius:50%;background:rgba(255,255,255,.2)}.play-triangle{margin-left:4rpx;border-top:9rpx solid transparent;border-bottom:9rpx solid transparent;border-left:14rpx solid #fff}
