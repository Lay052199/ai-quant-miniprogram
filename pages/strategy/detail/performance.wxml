<view class="performance-page">
  <image class="performance-background" src="/assets/backgrounds/home-bg.jpg" mode="aspectFill"></image>
  <view class="performance-header">
    <button class="back-button" bindtap="goBack"><view class="back-chevron"></view></button>
    <view class="performance-title">历史表现</view><view class="header-space"></view>
  </view>

  <view wx:if="{{!hasResult}}" class="empty-result">
    <view class="empty-orbit"><view class="empty-core"></view></view>
    <view class="empty-title">暂无该策略的真实回测数据</view>
    <view class="empty-copy">完成一次 {{strategy.name}} 回测后，这里将展示真实指标、净值曲线和交易统计。</view>
    <button class="empty-action" bindtap="useStrategy" loading="{{loading}}">使用该策略开始回测</button>
  </view>

  <block wx:else>
    <view class="result-overview">
      <view class="overview-eyebrow">真实回测记录</view>
      <view class="overview-name">{{summary.symbol}} · {{summary.strategy}}</view>
      <view class="overview-dates">{{summary.dates}}</view>
    </view>
    <view class="metric-grid">
      <metric-card wx:for="{{metrics}}" wx:key="key" label="{{item.label}}" value="{{item.value}}" tone="{{item.tone}}"></metric-card>
    </view>
    <chart-card title="净值曲线" subtitle="策略收益与沪深300基准逐交易日对比">
      <view class="chart-height net-height"><ec-canvas id="performance-net-chart" canvas-id="performance-net-chart" ec="{{netChartEc}}"></ec-canvas></view>
    </chart-card>
    <view class="chart-gap"></view>
    <chart-card title="月度收益" subtitle="正负收益按自然月统计">
      <view class="chart-height"><ec-canvas id="performance-monthly-chart" canvas-id="performance-monthly-chart" ec="{{monthlyChartEc}}"></ec-canvas></view>
    </chart-card>
    <view class="statistics-card">
      <view class="statistics-title">交易统计</view>
      <view class="statistics-grid">
        <view class="statistic-item" wx:for="{{statistics}}" wx:key="label"><view class="stat-label">{{item.label}}</view><view class="stat-value">{{item.value}}</view></view>
      </view>
    </view>
  </block>
  <view wx:if="{{errorMessage}}" class="performance-error">{{errorMessage}}</view>
</view>
