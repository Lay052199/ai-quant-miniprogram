.strategy-page {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
  overflow: hidden;
  padding: 24rpx 22rpx 52rpx;
  color: #172144;
  background: linear-gradient(135deg, #f5f7ff 0%, #f7f3ff 46%, #eef4ff 100%);
}

.page-background {
  position: absolute;
  z-index: 0;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0.72;
  pointer-events: none;
}

.page-glow {
  position: absolute;
  z-index: 0;
  width: 390rpx;
  height: 390rpx;
  border-radius: 50%;
  filter: blur(38rpx);
  pointer-events: none;
}

.glow-left {
  top: 700rpx;
  left: -270rpx;
  background: rgba(78, 132, 255, 0.14);
}

.glow-right {
  top: 1520rpx;
  right: -270rpx;
  background: rgba(151, 100, 247, 0.13);
}

.library-hero,
.featured-card,
.strategy-list-card,
.insight-card,
.empty-search {
  position: relative;
  z-index: 1;
  box-sizing: border-box;
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 18rpx 48rpx rgba(62, 78, 157, 0.12), inset 0 2rpx 0 rgba(255, 255, 255, 0.78);
}

.library-hero {
  height: 326rpx;
  overflow: hidden;
  border-width: 6rpx;
  border-radius: 39rpx;
  background: linear-gradient(120deg, #347df9 0%, #5369f4 55%, #8b59f2 100%);
  box-shadow: 0 22rpx 52rpx rgba(73, 82, 200, 0.26), 0 5rpx 14rpx rgba(255, 255, 255, 0.76);
}

.library-hero-art,
.library-hero-overlay {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.library-hero-overlay {
  background: linear-gradient(90deg, rgba(43, 117, 246, 0.74) 0%, rgba(61, 91, 232, 0.48) 54%, rgba(116, 68, 232, 0.03) 100%);
}

.library-hero-content {
  position: relative;
  z-index: 2;
  box-sizing: border-box;
  width: 72%;
  padding: 35rpx 0 0 32rpx;
  color: #ffffff;
}

.library-title {
  font-size: 39rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  text-shadow: 0 4rpx 16rpx rgba(25, 51, 142, 0.28);
}

.library-subtitle {
  margin-top: 9rpx;
  color: rgba(255, 255, 255, 0.9);
  font-size: 20rpx;
  line-height: 1.45;
  white-space: nowrap;
}

.hero-tool-row {
  display: flex;
  width: 614rpx;
  margin-top: 36rpx;
  align-items: center;
  gap: 12rpx;
}

.strategy-search {
  display: flex;
  min-width: 0;
  height: 66rpx;
  flex: 1;
  box-sizing: border-box;
  align-items: center;
  padding: 0 18rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 9rpx 24rpx rgba(24, 54, 152, 0.16), inset 0 2rpx 0 rgba(255, 255, 255, 0.8);
}

.search-icon {
  width: 29rpx;
  height: 29rpx;
  flex: 0 0 29rpx;
}

.search-input {
  min-width: 0;
  height: 100%;
  flex: 1;
  margin-left: 11rpx;
  color: #263354;
  font-size: 20rpx;
}

.search-placeholder {
  color: #8a96b5;
}

.filter-button {
  display: flex;
  width: 132rpx;
  height: 66rpx;
  margin: 0;
  padding: 0;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.76);
  border-radius: 20rpx;
  color: #5d59e9;
  background: rgba(255, 255, 255, 0.93);
  box-shadow: 0 9rpx 24rpx rgba(24, 54, 152, 0.16);
  font-size: 21rpx;
  font-weight: 650;
  line-height: 66rpx;
}

.filter-icon {
  width: 29rpx;
  height: 29rpx;
}

.offline-note {
  position: relative;
  z-index: 1;
  margin: 15rpx 4rpx 0;
  padding: 12rpx 16rpx;
  border: 1rpx solid rgba(231, 188, 102, 0.26);
  border-radius: 15rpx;
  color: #98703c;
  background: rgba(255, 249, 231, 0.78);
  font-size: 19rpx;
  text-align: center;
}

.category-scroll {
  position: relative;
  z-index: 2;
  width: 100%;
  margin-top: 23rpx;
  white-space: nowrap;
}

.category-tabs {
  display: inline-flex;
  min-width: 100%;
  box-sizing: border-box;
  padding: 6rpx;
  align-items: center;
  gap: 5rpx;
  border: 2rpx solid rgba(222, 228, 247, 0.72);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 11rpx 28rpx rgba(62, 78, 157, 0.075), inset 0 2rpx 0 rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
}

.category-tab {
  display: inline-flex;
  height: 58rpx;
  padding: 0 22rpx;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
  border-radius: 18rpx;
  color: #74809f;
  font-size: 21rpx;
  font-weight: 600;
  line-height: 58rpx;
}

.category-tab.active {
  color: #ffffff;
  background: linear-gradient(105deg, #5b88fa, #7c62ef 58%, #9b5dec);
  box-shadow: 0 9rpx 20rpx rgba(91, 98, 232, 0.23), inset 0 2rpx 0 rgba(255, 255, 255, 0.24);
}

.category-hot-icon {
  width: 25rpx;
  height: 25rpx;
}

.category-notice {
  position: relative;
  z-index: 1;
  margin-top: 10rpx;
  color: #7984a2;
  font-size: 18rpx;
  text-align: center;
}

.featured-card {
  margin-top: 22rpx;
  overflow: hidden;
  padding: 24rpx;
  border-radius: 29rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.92), rgba(244, 239, 255, 0.91));
}

.featured-light {
  position: absolute;
  top: -130rpx;
  right: -50rpx;
  width: 330rpx;
  height: 280rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(139, 93, 246, 0.16), rgba(139, 93, 246, 0));
  pointer-events: none;
}

.featured-header {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.featured-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #6156e9;
  font-size: 21rpx;
  font-weight: 700;
}

.featured-badge-icon {
  width: 29rpx;
  height: 29rpx;
}

.risk-pill {
  display: inline-flex;
  box-sizing: border-box;
  height: 34rpx;
  padding: 0 12rpx;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: 17rpx;
  font-weight: 650;
  line-height: 34rpx;
  white-space: nowrap;
}

.low-risk {
  color: #3f6be5;
  background: #eaf1ff;
}

.medium-risk {
  color: #c97a22;
  background: #fff2df;
}

.high-risk {
  color: #dc5564;
  background: #ffeaed;
}

.featured-body {
  position: relative;
  z-index: 1;
  display: flex;
  margin-top: 19rpx;
  gap: 20rpx;
}

.featured-copy {
  min-width: 0;
  flex: 1;
  padding: 7rpx 0 0 4rpx;
}

.featured-name {
  color: #182146;
  font-size: 31rpx;
  font-weight: 800;
}

.featured-description {
  margin-top: 11rpx;
  color: #65718f;
  font-size: 20rpx;
  line-height: 1.55;
}

.tag-row {
  display: flex;
  margin-top: 16rpx;
  flex-wrap: wrap;
  gap: 7rpx;
}

.strategy-tag {
  display: inline-flex;
  height: 31rpx;
  padding: 0 10rpx;
  align-items: center;
  border-radius: 10rpx;
  color: #6c70a7;
  background: rgba(234, 234, 255, 0.78);
  font-size: 16rpx;
  line-height: 31rpx;
}

.featured-action {
  width: 157rpx;
  height: 52rpx;
  margin: 20rpx 0 0;
  padding: 0;
  border-radius: 16rpx;
  color: #ffffff;
  background: linear-gradient(105deg, #5b88fa, #8165ef);
  box-shadow: 0 10rpx 22rpx rgba(82, 98, 224, 0.2);
  font-size: 20rpx;
  font-weight: 650;
  line-height: 52rpx;
}

.featured-performance {
  width: 252rpx;
  flex: 0 0 252rpx;
  box-sizing: border-box;
  padding: 17rpx 17rpx 13rpx;
  border: 2rpx solid rgba(219, 222, 246, 0.75);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.78);
  box-shadow: 0 11rpx 28rpx rgba(73, 82, 164, 0.09), inset 0 2rpx 0 rgba(255, 255, 255, 0.9);
}

.performance-label {
  color: #7682a2;
  font-size: 17rpx;
}

.performance-return {
  margin-top: 5rpx;
  color: #ef4c58;
  font-size: 30rpx;
  font-weight: 800;
}

.featured-sparkline {
  display: block;
  width: 100%;
  height: 58rpx;
  margin-top: 4rpx;
}

.performance-stats {
  display: flex;
  margin-top: 4rpx;
  align-items: center;
  justify-content: space-around;
}

.performance-stat {
  text-align: center;
}

.performance-stat-label {
  display: block;
  color: #8a95b2;
  font-size: 15rpx;
}

.performance-stat-value {
  margin-top: 2rpx;
  color: #34405f;
  font-size: 18rpx;
  font-weight: 700;
}

.performance-divider {
  width: 2rpx;
  height: 30rpx;
  background: #e6e9f5;
}

.strategy-section-header {
  position: relative;
  z-index: 1;
  display: flex;
  margin: 30rpx 5rpx 14rpx;
  align-items: flex-end;
  justify-content: space-between;
}

.section-title {
  color: #172144;
  font-size: 28rpx;
  font-weight: 800;
}

.section-caption {
  margin-top: 5rpx;
  color: #8993ae;
  font-size: 17rpx;
}

.strategy-count {
  color: #7784a6;
  font-size: 18rpx;
}

.empty-search {
  padding: 45rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.8);
  text-align: center;
}

.empty-search-title {
  color: #303c60;
  font-size: 24rpx;
  font-weight: 700;
}

.empty-search-text {
  display: block;
  margin-top: 8rpx;
  color: #8a95af;
  font-size: 19rpx;
}

.strategy-list-card {
  display: flex;
  min-height: 218rpx;
  margin-top: 13rpx;
  padding: 20rpx 18rpx;
  align-items: flex-start;
  gap: 14rpx;
  border-color: rgba(222, 227, 244, 0.75);
  border-radius: 25rpx;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.94), rgba(248, 249, 255, 0.85));
}

.strategy-icon {
  width: 66rpx;
  height: 66rpx;
  flex: 0 0 66rpx;
}

.strategy-main {
  min-width: 0;
  flex: 1;
  padding-top: 2rpx;
}

.strategy-name-row {
  display: flex;
  padding-right: 35rpx;
  align-items: center;
  gap: 9rpx;
}

.strategy-name {
  overflow: hidden;
  color: #192347;
  font-size: 24rpx;
  font-weight: 750;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.strategy-description {
  margin-top: 9rpx;
  color: #687391;
  font-size: 18rpx;
  line-height: 1.5;
}

.market-line {
  display: flex;
  margin-top: 9rpx;
  color: #697592;
  font-size: 17rpx;
  gap: 9rpx;
}

.market-label {
  color: #3f4e71;
  font-weight: 650;
}

.compact-tags {
  margin-top: 10rpx;
  gap: 5rpx;
}

.compact-tags .strategy-tag {
  height: 27rpx;
  padding: 0 8rpx;
  border-radius: 8rpx;
  font-size: 14rpx;
  line-height: 27rpx;
}

.strategy-metrics {
  width: 153rpx;
  flex: 0 0 153rpx;
  padding-top: 29rpx;
}

.strategy-metric {
  display: flex;
  margin-top: 6rpx;
  align-items: baseline;
  justify-content: space-between;
  gap: 6rpx;
}

.strategy-metric-label {
  color: #929bb4;
  font-size: 14rpx;
  white-space: nowrap;
}

.strategy-metric-value {
  color: #35415f;
  font-size: 17rpx;
  font-weight: 700;
  white-space: nowrap;
}

.return-metric .strategy-metric-value {
  color: #ec4a58;
  font-size: 20rpx;
}

.strategy-use-button {
  box-sizing: border-box;
  width: 100%;
  height: 45rpx;
  margin: 13rpx 0 0;
  padding: 0;
  border-radius: 14rpx;
  color: #5f62e8;
  background: #eef0ff;
  font-size: 17rpx;
  font-weight: 650;
  line-height: 45rpx;
  text-align: center;
  white-space: nowrap;
}

.favorite-button {
  position: absolute;
  z-index: 3;
  top: 13rpx;
  right: 13rpx;
  width: 42rpx;
  height: 42rpx;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  background: rgba(247, 248, 255, 0.9);
  line-height: 42rpx;
}

.favorite-icon {
  width: 27rpx;
  height: 27rpx;
}

.bottom-insight-grid {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 1.16fr 0.84fr;
  margin-top: 24rpx;
  gap: 13rpx;
}

.insight-card {
  min-width: 0;
  padding: 20rpx 17rpx;
  border-color: rgba(222, 227, 244, 0.74);
  border-radius: 25rpx;
  background: rgba(255, 255, 255, 0.82);
}

.insight-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.insight-heading-title {
  color: #1d294d;
  font-size: 22rpx;
  font-weight: 750;
}

.insight-heading-link {
  color: #7475e9;
  font-size: 15rpx;
}

.preview-name-row {
  display: flex;
  margin-top: 16rpx;
  align-items: center;
  gap: 10rpx;
}

.preview-icon {
  width: 52rpx;
  height: 52rpx;
  flex: 0 0 52rpx;
}

.preview-strategy-name {
  display: block;
  color: #283353;
  font-size: 19rpx;
  font-weight: 700;
}

.preview-name-row .risk-pill {
  width: fit-content;
  height: 28rpx;
  margin-top: 4rpx;
  padding: 0 9rpx;
  font-size: 14rpx;
  line-height: 28rpx;
}

.preview-description {
  margin-top: 12rpx;
  color: #737e99;
  font-size: 16rpx;
  line-height: 1.5;
}

.preview-detail {
  display: flex;
  min-height: 31rpx;
  margin-top: 8rpx;
  align-items: center;
  color: #8791aa;
  font-size: 15rpx;
}

.preview-detail-label {
  width: 104rpx;
  flex: 0 0 104rpx;
}

.detail-value {
  color: #4c5876;
  font-size: 15rpx;
  font-weight: 650;
}

.dot-level {
  display: flex;
  margin-right: 6rpx;
  gap: 4rpx;
}

.level-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #dce1ef;
}

.level-dot.filled {
  background: #706ff3;
}

.star-level {
  color: #7f6df3;
  font-size: 16rpx;
  letter-spacing: 1rpx;
}

.recent-item {
  display: flex;
  min-height: 82rpx;
  margin-top: 11rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid rgba(225, 229, 242, 0.8);
  gap: 6rpx;
}

.recent-copy {
  min-width: 0;
  flex: 1;
}

.recent-name {
  display: block;
  overflow: hidden;
  color: #34405f;
  font-size: 17rpx;
  font-weight: 700;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recent-time {
  margin-top: 4rpx;
  color: #9aa3b9;
  font-size: 12rpx;
  white-space: nowrap;
}

.recent-play {
  width: 38rpx;
  height: 38rpx;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  background: transparent;
  line-height: 38rpx;
}

.recent-play-icon {
  width: 34rpx;
  height: 34rpx;
}

.filter-button::after,
.featured-action::after,
.strategy-use-button::after,
.favorite-button::after,
.recent-play::after {
  border: 0;
}
