<view class="result-page">
  <view wx:if="{{!hasResult}}" class="empty-card">
    <view class="empty-orbit"><view class="empty-dot"></view></view>
    <view class="empty-title">还没有回测结果</view>
    <view class="empty-text">请先选择个股和策略，完成一次历史回测。</view>
    <button class="primary-button" bindtap="goToBacktest">前往回测</button>
  </view>

  <block wx:if="{{hasResult}}">
    <view class="overview-banner">
      <image class="overview-art" src="/assets/quant-hero.jpg" mode="aspectFill"></image>
      <view class="overview-glow"></view>
      <view class="overview-content">
        <view class="overview-title">回测结果总览 <text>✦</text></view>
        <view class="overview-fields">
          <view class="overview-field overview-stock">
            <text>股票</text>
            <view>{{summary.stockDisplay}}</view>
          </view>
          <view class="overview-field overview-strategy">
            <text>策略</text>
            <view>{{summary.strategy}}</view>
          </view>
          <view class="overview-field overview-period">
            <text>回测周期</text>
            <view>{{summary.dates}}</view>
          </view>
        </view>
      </view>
    </view>

    <view class="dashboard-card metric-panel">
      <view class="metric-grid">
        <view class="metric-card">
          <view class="metric-label">累计收益率 <text class="info-dot">i</text></view>
          <view class="metric-value {{coreMetrics.totalReturn.tone}}">{{coreMetrics.totalReturn.value}}</view>
          <view class="metric-mini-chart"><image class="metric-mini-image" src="/assets/charts/total-return-sparkline.svg" mode="aspectFit"></image></view>
        </view>
        <view class="metric-card">
          <view class="metric-label">年化收益率 <text class="info-dot">i</text></view>
          <view class="metric-value {{coreMetrics.annualReturn.tone}}">{{coreMetrics.annualReturn.value}}</view>
          <view class="metric-mini-chart"><image class="metric-mini-image" src="/assets/charts/annual-return-sparkline.svg" mode="aspectFit"></image></view>
        </view>
        <view class="metric-card">
          <view class="metric-label">最大回撤 <text class="info-dot">i</text></view>
          <view class="metric-value safe">{{coreMetrics.maxDrawdown.value}}</view>
          <view class="metric-mini-chart"><image class="metric-mini-image" src="/assets/charts/max-drawdown-sparkline.svg" mode="aspectFit"></image></view>
        </view>
        <view class="metric-card">
          <view class="metric-label">夏普比率 <text class="info-dot">i</text></view>
          <view class="metric-value neutral">{{coreMetrics.sharpeRatio.value}}</view>
          <view class="metric-mini-chart"><image class="metric-mini-image" src="/assets/charts/sharpe-sparkline.svg" mode="aspectFit"></image></view>
        </view>
        <view class="metric-card metric-with-chart">
          <view>
            <view class="metric-label">胜率 <text class="info-dot">i</text></view>
            <view class="metric-value neutral">{{coreMetrics.winRate.value}}</view>
          </view>
          <view class="win-chart-wrap">
            <ec-canvas id="win-rate-chart" canvas-id="win-rate-chart" ec="{{winRateChartEc}}"></ec-canvas>
          </view>
        </view>
        <view class="metric-card">
          <view class="metric-label">交易次数 <text class="info-dot">i</text></view>
          <view class="metric-value neutral">{{coreMetrics.tradeCount.value}}</view>
          <view class="metric-mini-chart histogram-chart"><image class="metric-mini-image" src="/assets/charts/trade-count-histogram.svg" mode="aspectFit"></image></view>
        </view>
      </view>
    </view>

    <view class="dashboard-card chart-card">
      <view class="card-header">
        <view class="section-heading no-margin">净值曲线</view>
        <view class="range-tabs">
          <view class="{{curveRange === '6m' ? 'active' : ''}}" data-range="6m" bindtap="onCurveRangeChange">近6月</view>
          <view class="{{curveRange === '1y' ? 'active' : ''}}" data-range="1y" bindtap="onCurveRangeChange">近1年</view>
          <view class="{{curveRange === 'all' ? 'active' : ''}}" data-range="all" bindtap="onCurveRangeChange">全部</view>
        </view>
      </view>
      <view class="net-chart">
        <ec-canvas id="net-chart" canvas-id="net-chart" ec="{{netChartEc}}"></ec-canvas>
      </view>
    </view>

    <view class="analysis-grid">
      <view class="dashboard-card compact-chart-card">
        <view class="section-heading compact-heading">月度收益（%）</view>
        <view class="small-chart">
          <ec-canvas id="monthly-chart" canvas-id="monthly-chart" ec="{{monthlyChartEc}}"></ec-canvas>
        </view>
      </view>
      <view class="dashboard-card compact-chart-card">
        <view class="section-heading compact-heading">收益分布 <text class="info-dot">i</text></view>
        <view class="small-chart">
          <ec-canvas id="distribution-chart" canvas-id="distribution-chart" ec="{{distributionChartEc}}"></ec-canvas>
        </view>
      </view>
    </view>

    <view class="dashboard-card">
      <view class="section-heading">交易统计</view>
      <view class="trade-stat-grid">
        <view class="trade-stat">
          <view><text>平均持仓天数</text><view>{{tradeStatistics.averageHoldingDays}}</view></view>
          <view class="stat-icon blue-icon">▣</view>
        </view>
        <view class="trade-stat">
          <view><text>盈亏比</text><view>{{tradeStatistics.profitLossRatio}}</view></view>
          <view class="stat-icon purple-icon">⚖</view>
        </view>
        <view class="trade-stat">
          <view><text>最大连续盈利</text><view>{{tradeStatistics.maxConsecutiveWins}}</view></view>
          <view class="stat-icon blue-icon">↗</view>
        </view>
        <view class="trade-stat">
          <view><text>最大连续亏损</text><view>{{tradeStatistics.maxConsecutiveLosses}}</view></view>
          <view class="stat-icon gray-icon">↘</view>
        </view>
      </view>
    </view>

    <view class="dashboard-card insight-card">
      <image class="insight-art" src="/assets/result-report-3d.jpg" mode="aspectFill"></image>
      <view class="insight-art-fade"></view>
      <view class="insight-content">
        <view class="insight-header">
          <view class="ai-badge">AI</view>
          <view class="section-heading no-margin">结果解读</view>
          <view class="rule-tag">智能分析</view>
        </view>
        <view wx:for="{{interpretations}}" wx:key="index" class="insight-row">
          <view class="check-icon">✓</view>
          <text>{{item}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{benchmark}}" class="dashboard-card detail-card">
      <view class="section-heading">基准收益对比</view>
      <view class="detail-highlight">{{benchmark.conclusion}}</view>
      <view class="muted">{{benchmark.explanation}}</view>
    </view>

    <view wx:if="{{analysis}}" class="dashboard-card detail-card">
      <view class="section-heading">回测结论</view>
      <view class="paragraph">{{analysis.summary}}</view>
      <view class="paragraph">{{analysis.return_analysis}}</view>
      <view class="paragraph">{{analysis.risk_analysis}}</view>
    </view>

    <view class="dashboard-card detail-card">
      <view class="section-heading">风险提示</view>
      <view wx:for="{{riskReport}}" wx:key="index" class="risk-item"><text>!</text><view>{{item}}</view></view>
      <view wx:if="{{!riskReport.length}}" class="muted">暂无风险提示</view>
    </view>

    <view class="dashboard-card detail-card">
      <view class="section-heading">参数敏感性分析</view>
      <button class="secondary-button" bindtap="startSensitivity" loading="{{sensitivityLoading}}">运行敏感性分析</button>
      <view wx:if="{{sensitivitySummary}}" class="detail-highlight">{{sensitivitySummary.explanation}}</view>
      <view wx:for="{{sensitivityResults}}" wx:key="params_label" class="sensitivity-item">
        <text>{{item.params_label}}</text><text>{{item.conclusion}}</text>
      </view>
    </view>

    <view class="dashboard-card detail-card">
      <view class="section-heading">中文分析报告</view>
      <view class="report">{{reportText}}</view>
      <button class="secondary-button" bindtap="copyReport">复制报告</button>
    </view>

    <view class="dashboard-card detail-card">
      <view class="section-heading">交易记录</view>
      <scroll-view scroll-x wx:if="{{trades.length}}">
        <view class="trade-row trade-head"><text>买入日期</text><text>卖出日期</text><text>收益</text></view>
        <view class="trade-row" wx:for="{{trades}}" wx:key="index"><text>{{item.buy_date}}</text><text>{{item.sell_date || '持仓中'}}</text><text>{{item.profit}}</text></view>
      </scroll-view>
      <view wx:else class="muted">当前区间没有完整交易记录</view>
    </view>

    <view class="dashboard-card disclaimer">
      <view class="section-heading">免责声明</view>
      历史回测不代表未来收益，本工具仅用于学习、研究和模拟分析。
    </view>
  </block>
</view>
