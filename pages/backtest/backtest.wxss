.page-shell {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
  overflow: hidden;
  padding: 24rpx 22rpx 48rpx;
  color: #172144;
  background: linear-gradient(135deg, #f5f7ff 0%, #f7f3ff 45%, #eef3ff 100%);
}

.home-background-art {
  position: absolute;
  z-index: 0;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0.78;
  pointer-events: none;
}

.ambient {
  position: absolute;
  z-index: 0;
  width: 390rpx;
  height: 390rpx;
  border-radius: 50%;
  filter: blur(34rpx);
  opacity: 0.48;
  pointer-events: none;
}

.ambient-left {
  top: 620rpx;
  left: -230rpx;
  background: rgba(111, 150, 255, 0.16);
}

.ambient-right {
  top: 1080rpx;
  right: -250rpx;
  background: rgba(178, 124, 255, 0.14);
}

.hero-card,
.main-panel {
  position: relative;
  z-index: 1;
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
}

.hero-card {
  height: 318rpx;
  overflow: hidden;
  border-width: 7rpx;
  border-color: rgba(255, 255, 255, 0.92);
  border-radius: 40rpx;
  background: linear-gradient(120deg, #377dff 0%, #5365f5 54%, #8b55f4 100%);
  box-shadow: 0 22rpx 50rpx rgba(72, 86, 206, 0.27), 0 5rpx 14rpx rgba(255, 255, 255, 0.82);
}

.hero-illustration,
.hero-grid,
.hero-overlay {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.hero-illustration {
  z-index: 0;
}

.hero-grid {
  z-index: 1;
  left: 54%;
  width: 46%;
  opacity: 0.18;
  background-image: linear-gradient(rgba(255, 255, 255, 0.13) 2rpx, transparent 2rpx), linear-gradient(90deg, rgba(255, 255, 255, 0.13) 2rpx, transparent 2rpx);
  background-size: 42rpx 42rpx;
}

.hero-overlay {
  z-index: 1;
  background: linear-gradient(90deg, rgba(37, 112, 248, 0.78) 0%, rgba(61, 92, 238, 0.53) 50%, rgba(113, 69, 234, 0.08) 76%, rgba(128, 80, 243, 0) 100%);
}

.hero-copy {
  position: relative;
  z-index: 3;
  width: 67%;
  box-sizing: border-box;
  padding: 57rpx 0 0 34rpx;
  color: #ffffff;
}

.hero-title {
  white-space: nowrap;
  font-size: 37rpx;
  font-weight: 800;
  line-height: 1.25;
  letter-spacing: -0.5rpx;
  text-shadow: 0 4rpx 16rpx rgba(29, 43, 140, 0.28);
}

.hero-desc {
  display: flex;
  flex-direction: column;
  gap: 7rpx;
  margin-top: 25rpx;
  font-size: 21rpx;
  line-height: 1.58;
  color: rgba(255, 255, 255, 0.94);
  text-shadow: 0 2rpx 8rpx rgba(33, 50, 133, 0.25);
}

.hero-desc-line {
  white-space: nowrap;
}

.main-panel {
  margin-top: 25rpx;
  padding: 34rpx 25rpx 30rpx;
  border-color: rgba(255, 255, 255, 0.96);
  border-radius: 39rpx;
  background: rgba(255, 255, 255, 0.84);
  box-shadow: 0 24rpx 62rpx rgba(69, 83, 166, 0.15), inset 0 2rpx 0 rgba(255, 255, 255, 0.92);
}

.glass-panel {
  backdrop-filter: blur(28rpx);
  -webkit-backdrop-filter: blur(28rpx);
}

.form-section {
  margin-top: 39rpx;
}

.first-section {
  margin-top: 0;
}

.compact-section {
  margin-top: 30rpx;
}

.section-title,
.parameter-heading {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 18rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #172144;
}

.module-icon {
  width: 42rpx;
  height: 42rpx;
  flex: 0 0 42rpx;
}

.stock-display-row,
.date-field,
.strategy-field,
.library-button,
.overview-metric-card,
.parameter-card,
.param-input-wrap {
  box-sizing: border-box;
  border: 2rpx solid rgba(207, 217, 242, 0.74);
  background: rgba(255, 255, 255, 0.86);
  box-shadow: 0 9rpx 22rpx rgba(58, 75, 150, 0.075), inset 0 1rpx 0 rgba(255, 255, 255, 0.92);
}

.stock-display-row {
  display: flex;
  align-items: center;
  height: 92rpx;
  padding: 0 21rpx;
  border-radius: 22rpx;
  box-shadow: 0 11rpx 26rpx rgba(58, 75, 150, 0.085), inset 0 2rpx 0 rgba(255, 255, 255, 0.96);
}

.stock-display-row.error {
  border-color: rgba(239, 115, 129, 0.52);
}

.stock-input {
  width: 216rpx;
  height: 100%;
  flex: 0 0 210rpx;
  font-size: 29rpx;
  font-weight: 550;
  color: #16203f;
}

.stock-market-info {
  display: flex;
  min-width: 0;
  flex: 1;
  align-items: center;
  justify-content: flex-end;
  gap: 15rpx;
}

.stock-name {
  max-width: 126rpx;
  overflow: hidden;
  color: #6f7d9d;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stock-change {
  flex: 0 0 auto;
  color: #ff4f57;
  font-size: 23rpx;
  font-weight: 650;
}

.stock-sparkline {
  position: relative;
  width: 92rpx;
  height: 35rpx;
  flex: 0 0 92rpx;
}

.sparkline-segment {
  position: absolute;
  width: 20rpx;
  height: 3rpx;
  border-radius: 4rpx;
  background: #4263f3;
  transform-origin: left center;
}

.sparkline-segment-1 { left: 0; top: 26rpx; transform: rotate(-30deg); }
.sparkline-segment-2 { left: 17rpx; top: 17rpx; transform: rotate(21deg); }
.sparkline-segment-3 { left: 34rpx; top: 23rpx; transform: rotate(-39deg); }
.sparkline-segment-4 { left: 50rpx; top: 10rpx; transform: rotate(25deg); }
.sparkline-segment-5 { left: 67rpx; top: 17rpx; transform: rotate(-26deg); }
.sparkline-segment-6 { left: 82rpx; top: 10rpx; width: 10rpx; transform: rotate(-17deg); }

.stock-feedback {
  min-height: 28rpx;
  margin: 9rpx 5rpx 0;
  color: #7b87a6;
  font-size: 20rpx;
}

.stock-feedback.error {
  color: #d65364;
}

.date-label-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 62rpx;
  padding: 0 11rpx 11rpx;
  color: #667392;
  font-size: 20rpx;
}

.date-row {
  display: flex;
  align-items: center;
  gap: 13rpx;
}

.date-picker {
  min-width: 0;
  flex: 1;
}

.date-field,
.strategy-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 84rpx;
  padding: 0 20rpx;
  border-radius: 21rpx;
  font-size: 24rpx;
  color: #172144;
}

.field-tail-icon {
  width: 31rpx;
  height: 31rpx;
  opacity: 0.68;
}

.date-split {
  color: #273251;
  font-size: 23rpx;
  font-weight: 600;
}

.strategy-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.strategy-picker {
  min-width: 0;
  flex: 1;
}

.select-chevron {
  width: 14rpx;
  height: 14rpx;
  border-right: 3rpx solid #263252;
  border-bottom: 3rpx solid #263252;
  transform: rotate(45deg) translateY(-4rpx);
}

.library-button {
  display: flex;
  width: 158rpx;
  height: 84rpx;
  margin: 0;
  padding: 0;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
  border-radius: 21rpx;
  color: #5263f5;
  font-size: 23rpx;
  line-height: 84rpx;
}

.library-icon-image {
  width: 34rpx;
  height: 34rpx;
}

.strategy-explain-card {
  position: relative;
  min-height: 252rpx;
  overflow: hidden;
  box-sizing: border-box;
  padding: 25rpx 20rpx;
  border: 2rpx solid rgba(217, 210, 251, 0.82);
  border-radius: 26rpx;
  background: linear-gradient(135deg, rgba(250, 249, 255, 0.98), rgba(240, 235, 255, 0.94));
  box-shadow: 0 13rpx 30rpx rgba(99, 80, 190, 0.11), inset 0 2rpx 0 #ffffff;
}

.strategy-explain-art,
.strategy-explain-fade {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.strategy-explain-fade {
  background: linear-gradient(90deg, rgba(248, 247, 255, 0.99) 0%, rgba(247, 244, 255, 0.97) 60%, rgba(247, 244, 255, 0.2) 100%);
}

.strategy-explain-content {
  position: relative;
  z-index: 2;
  display: flex;
  width: 76%;
  flex-direction: column;
  gap: 11rpx;
}

.explain-line {
  display: grid;
  grid-template-columns: 27rpx 1fr;
  gap: 8rpx;
  color: #536080;
  font-size: 19rpx;
  line-height: 1.48;
}

.bullet-icon {
  width: 25rpx;
  height: 25rpx;
  margin-top: 1rpx;
}

.explain-label {
  color: #2f3b62;
  font-weight: 650;
}

.overview-metric-grid,
.metric-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 15rpx;
}

.overview-metric-card {
  display: flex;
  min-width: 0;
  height: 148rpx;
  padding: 23rpx 18rpx;
  align-items: flex-start;
  gap: 14rpx;
  border-radius: 24rpx;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.96), rgba(248, 249, 255, 0.88));
  box-shadow: 0 12rpx 28rpx rgba(58, 75, 150, 0.08), inset 0 2rpx 0 rgba(255, 255, 255, 0.96);
}

.metric-icon-image {
  width: 46rpx;
  height: 46rpx;
  flex: 0 0 46rpx;
}

.metric-body {
  min-width: 0;
  flex: 1;
}

.metric-label {
  display: block;
  color: #344160;
  font-size: 21rpx;
  font-weight: 550;
}

.metric-value-row {
  display: flex;
  min-width: 0;
  margin-top: 9rpx;
  align-items: baseline;
  justify-content: space-between;
  gap: 4rpx;
}

.metric-input {
  width: 138rpx;
  height: 46rpx;
  min-width: 0;
  color: #111b3b;
  font-size: 28rpx;
  font-weight: 750;
}

.large-input {
  font-size: 30rpx;
}

.metric-unit {
  flex: 0 0 auto;
  color: #7180a4;
  font-size: 18rpx;
}

.period-value {
  color: #111b3b;
  font-size: 29rpx;
  font-weight: 750;
  white-space: nowrap;
}

.period-unit {
  font-size: 19rpx;
  font-weight: 500;
}

.parameter-card {
  padding: 24rpx 19rpx 21rpx;
  border-radius: 25rpx;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.91), rgba(247, 248, 255, 0.8));
  box-shadow: 0 12rpx 28rpx rgba(58, 75, 150, 0.07), inset 0 2rpx 0 rgba(255, 255, 255, 0.94);
}

.parameter-heading {
  margin-bottom: 19rpx;
  font-size: 25rpx;
}

.param-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx 18rpx;
}

.param-item {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 10rpx;
}

.param-label {
  min-width: 0;
  flex: 1;
  color: #5d6987;
  font-size: 18rpx;
}

.param-input-wrap {
  display: flex;
  width: 134rpx;
  height: 64rpx;
  padding: 0 14rpx;
  align-items: center;
  border-radius: 17rpx;
  background: rgba(255, 255, 255, 0.95);
}

.param-value-input {
  width: 78rpx;
  min-width: 0;
  flex: 1;
  color: #172144;
  font-size: 24rpx;
  font-weight: 650;
}

.param-unit {
  color: #536184;
  font-size: 18rpx;
}

.primary-action {
  height: 94rpx;
  margin: 30rpx 0 0;
  padding: 0;
  border-radius: 25rpx;
  color: #ffffff;
  background: linear-gradient(105deg, #4b8ff8 0%, #5964f2 52%, #b13deb 100%);
  box-shadow: 0 18rpx 34rpx rgba(84, 71, 226, 0.31), inset 0 2rpx 0 rgba(255, 255, 255, 0.3);
  font-size: 30rpx;
  font-weight: 750;
  line-height: 94rpx;
}

.cta-content {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
}

.cta-play-icon {
  position: relative;
  width: 42rpx;
  height: 42rpx;
  flex: 0 0 42rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.35);
}

.cta-play-icon::after {
  position: absolute;
  top: 12rpx;
  left: 16rpx;
  width: 0;
  height: 0;
  border-top: 9rpx solid transparent;
  border-bottom: 9rpx solid transparent;
  border-left: 13rpx solid #ffffff;
  content: "";
}

.health-button {
  height: 48rpx;
  margin: 7rpx 0 0;
  padding: 0;
  color: #7a86a5;
  background: transparent;
  font-size: 19rpx;
  line-height: 48rpx;
}

.library-button::after,
.primary-action::after,
.health-button::after {
  border: 0;
}

.error-box {
  margin-top: 8rpx;
  padding: 17rpx;
  border-radius: 16rpx;
  color: #b91c1c;
  background: #fef2f2;
  font-size: 22rpx;
}
