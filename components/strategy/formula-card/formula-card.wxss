.formula-card {
  padding: 10rpx 12rpx;
  border: 1rpx solid rgba(82, 109, 255, 0.17);
  border-radius: 14rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.92), rgba(242, 245, 255, 0.78));
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
}
.formula-title { display: none; }
.formula-line { margin-top: 3rpx; color: #172554; font-family: Georgia, serif; font-size: 18rpx; line-height: 1.35; text-align: center; }
.formula-note { display: none; }
