.metric-card{position:relative;box-sizing:border-box;min-height:142rpx;padding:22rpx;overflow:hidden;border:1rpx solid rgba(224,230,251,.8);border-radius:24rpx;background:rgba(255, 255, 255,.88);box-shadow:0 10rpx 28rpx rgba(79,91,177,.07)}.metric-label{color:#7180a4;font-size:21rpx}.metric-value{margin-top:10rpx;color:#172554;font-size:33rpx;font-weight:800}.metric-value.positive{color:#ef4444}.metric-value.safe{color:#14a99a}.metric-hint{margin-top:6rpx;color:#9aa6c0;font-size:19rpx}.metric-accent{position:absolute;right:-18rpx;bottom:-24rpx;width:88rpx;height:58rpx;border-radius:50%;background:rgba(82,109,255,.09)}.metric-accent.safe{background:rgba(20,169,154,.1)}
