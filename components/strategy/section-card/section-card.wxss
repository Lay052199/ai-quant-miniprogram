.section-card{box-sizing:border-box;padding:27rpx;border:1rpx solid rgba(224,230,251,.82);border-radius:28rpx;background:rgba(255, 255, 255,.86);box-shadow:0 12rpx 34rpx rgba(77,88,166,.08);backdrop-filter:blur(20rpx)}.section-card.warm{border-color:rgba(251,191,36,.18);background:rgba(255,250,238,.9)}.section-heading{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.section-title-wrap{display:flex;align-items:center;gap:13rpx}.section-icon{width:34rpx;height:34rpx}.section-title{color:#172554;font-size:29rpx;font-weight:760}.section-subtitle{margin-top:3rpx;color:#94a3b8;font-size:20rpx}.section-action{color:#526dff;font-size:22rpx}.section-content{margin-top:20rpx;color:#52617b;font-size:24rpx;line-height:1.7}
