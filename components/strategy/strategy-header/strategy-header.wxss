.strategy-header {
  display: grid;
  grid-template-columns: 1.05fr 1fr;
  overflow: hidden;
  border: 1rpx solid rgba(142, 157, 225, 0.22);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 12rpx 34rpx rgba(79, 96, 169, 0.095);
  backdrop-filter: blur(18rpx);
}
.header-copy, .performance-panel { min-height: 230rpx; padding: 22rpx 24rpx; box-sizing: border-box; }
.header-copy { border-right: 1rpx solid rgba(136, 151, 214, 0.16); }
.identity-row { display: flex; align-items: center; gap: 10rpx; }
.strategy-name { color: #172554; font-size: 30rpx; font-weight: 760; }
.description { margin-top: 15rpx; color: #405078; font-size: 21rpx; line-height: 1.62; }
.meta-row { display: flex; gap: 30rpx; margin-top: 17rpx; color: #23365f; font-size: 20rpx; }
.meta-label { display: block; margin-bottom: 4rpx; color: #8a98bb; }
.performance-panel { background: linear-gradient(145deg, rgba(247, 249, 255, 0.64), rgba(243, 238, 255, 0.52)); }
.performance-label { color: #8a96b7; font-size: 20rpx; }
.return-value { margin: 5rpx 0 0; color: #7c4dff; font-size: 42rpx; font-weight: 760; }
.header-sparkline { display: block; width: 100%; height: 56rpx; margin: 3rpx 0; }
.performance-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; color: #8793b4; font-size: 19rpx; }
.performance-grid .metric-strong { display: block; margin-top: 3rpx; color: #172554; font-size: 26rpx; font-weight: 700; }
.empty-performance { position: relative; min-height: 184rpx; color: #5c6b92; }
.empty-value { margin-top: 5rpx; color: #a7b0c9; font-size: 42rpx; font-weight: 760; }
.empty-sparkline { position: relative; height: 48rpx; margin-top: -2rpx; overflow: hidden; border-bottom: 1rpx solid rgba(112, 132, 207, .12); }
.empty-line { position: absolute; height: 2rpx; border-radius: 4rpx; background: linear-gradient(90deg, rgba(82, 109, 255, .14), rgba(139, 92, 246, .24)); transform-origin: left center; }
.line-one { left: 2%; bottom: 14rpx; width: 36%; transform: rotate(-5deg); }
.line-two { left: 36%; bottom: 18rpx; width: 28%; transform: rotate(4deg); }
.line-three { left: 63%; bottom: 14rpx; width: 35%; transform: rotate(-8deg); }
.empty-metrics { margin-top: 7rpx; opacity: .76; }
.empty-caption { position: absolute; right: 0; top: 5rpx; color: #a1aac2; font-size: 15rpx; }
