.chart-card{box-sizing:border-box;padding:28rpx;border:1rpx solid rgba(224,230,251,.82);border-radius:30rpx;background:rgba(255, 255, 255,.88);box-shadow:0 14rpx 36rpx rgba(78,90,176,.08)}.chart-heading{display:flex;align-items:flex-start;justify-content:space-between}.chart-title{color:#172554;font-size:29rpx;font-weight:780}.chart-subtitle{margin-top:6rpx;color:#94a3b8;font-size:20rpx}.chart-body{margin-top:22rpx}.chart-state{display:flex;min-height:260rpx;align-items:center;justify-content:center;color:#94a3b8;font-size:23rpx}
