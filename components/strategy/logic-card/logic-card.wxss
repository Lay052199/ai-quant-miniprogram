.logic-card {
  position: relative;
  min-height: 152rpx;
  overflow: hidden;
  padding: 17rpx 18rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(128, 149, 226, 0.22);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.82);
  height: 100%;
}
.logic-card-title { color: #526dff; font-size: 23rpx; font-weight: 720; }
.logic-card-copy { position: relative; z-index: 1; margin-top: 9rpx; color: #485879; font-size: 18rpx; line-height: 1.56; }
.logic-card-accent { position: absolute; right: -18rpx; top: -18rpx; width: 80rpx; height: 80rpx; border-radius: 50%; background: rgba(82, 109, 255, 0.08); }
.tone-green { border-color: rgba(54, 190, 117, 0.25); background: rgba(244, 255, 249, 0.78); }
.tone-green .logic-card-title { color: #20a35f; }
.tone-green .logic-card-accent { background: rgba(42, 190, 111, 0.1); }
.tone-red { border-color: rgba(241, 91, 111, 0.22); background: rgba(255, 247, 248, 0.8); }
.tone-red .logic-card-title { color: #eb4762; }
.tone-red .logic-card-accent { background: rgba(241, 91, 111, 0.09); }
