.market-card {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.market-box { min-height: 0; padding: 12rpx 14rpx; box-sizing: border-box; border-radius: 14rpx; }
.suitable { border: 1rpx solid rgba(39, 178, 100, .2); background: rgba(239, 253, 245, .78); }
.unsuitable { border: 1rpx solid rgba(237, 83, 104, .18); background: rgba(255, 244, 246, .78); }
.market-heading { margin-bottom: 7rpx; color: #23a05b; font-size: 20rpx; font-weight: 700; }
.unsuitable .market-heading { color: #e84961; }
.market-heading text { display: inline-flex; width: 22rpx; height: 22rpx; margin-right: 5rpx; align-items: center; justify-content: center; border: 1rpx solid currentColor; border-radius: 50%; font-size: 14rpx; }
.market-line { margin-top: 5rpx; color: #53617e; font-size: 16rpx; line-height: 1.35; }
.market-line text { margin-right: 8rpx; color: #2bad67; }
.unsuitable .market-line text { color: #eb5067; }
