.strategy-hero{position:relative;display:flex;gap:24rpx;padding:30rpx;overflow:hidden;border:1rpx solid rgba(255,255,255,.9);border-radius:32rpx;background:linear-gradient(135deg,rgba(69,104,255,.96),rgba(139,92,246,.92));box-shadow:0 18rpx 44rpx rgba(77,83,190,.2);color:#fff}.hero-glow{position:absolute;right:-80rpx;top:-90rpx;width:260rpx;height:260rpx;border-radius:50%;background:rgba(255,255,255,.2);filter:blur(30rpx)}.hero-copy{position:relative;z-index:1;flex:1;min-width:0}.hero-eyebrow{font-size:21rpx;opacity:.74;letter-spacing:3rpx}.hero-name-row{display:flex;align-items:center;gap:14rpx;margin-top:7rpx}.hero-name{font-size:36rpx;font-weight:800}.hero-summary{margin-top:12rpx;font-size:24rpx;line-height:1.55;opacity:.9}.hero-tags{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:15rpx}.hero-tag{padding:6rpx 13rpx;border:1rpx solid rgba(255,255,255,.25);border-radius:18rpx;background:rgba(255,255,255,.13);font-size:20rpx}
