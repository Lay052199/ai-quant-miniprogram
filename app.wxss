page {
  background: #f5f7ff;
  color: #101936;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page-container {
  padding: 24rpx;
}

.card {
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(219, 226, 255, 0.9);
  border-radius: 28rpx;
  box-shadow: 0 18rpx 50rpx rgba(61, 83, 176, 0.1);
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 20rpx;
}

.section-subtitle {
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 20rpx;
}
